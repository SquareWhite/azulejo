  "radius": {
    "_note": "Tile values follow the mockup (D.5); sidebar card target 12 (D.3). focus: a border drawn just outside a tile (the attention border). tabStrip/tab/search*: the toolbar (D.2/D.4/D.8, from the mockup). badgeDot/machineDot: the agent badge's state dot and a machine's connection dot (round, so each is half the dot's width).",
    "window": 12,
    "card": 12,
    "tile": 10,
    "focus": 11,
    "terminal": 4,
    "overlay": 4,
    "ghost": 4,
    "row": 5,
    "pill": 6,
    "field": 6,
    "toast": 6,
