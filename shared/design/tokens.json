{
  "_about": "Azulejo design tokens. Single source for colours, radii, spacing, type, status icons and motion. The macOS shell reads them through apps/macos/Sources/Azulejo/Design.swift, generated by scripts/design-tokens; the Linux shell (M3) reads this file too. Colours come from docs/design/mockup-v1.png (One Dark); radii and spacing are the values shipping today, and docs/design/README.md lists the mockup targets that D.5 moves them to. Light colours are provisional. Hex colours are #rrggbb or #rrggbbaa. Keys starting with an underscore are notes.",
  "version": 1,

  "color": {
    "_note": "Each colour has a dark and a light value; the shell picks one from the window's appearance.",
    "window":            { "dark": "#1b1d23", "light": "#eceef1", "_use": "window background, gutters between tiles, toolbar row" },
    "sidebar":           { "dark": "#21252b", "light": "#f5f6f8", "_use": "sidebar card, tab bar, tile header strip" },
    "tile":              { "dark": "#282c34", "light": "#ffffff", "_use": "tile body: terminal backdrop, browser, preview, files" },
    "tileAlt":           { "dark": "#252930", "light": "#fafbfc", "_use": "secondary tile bodies" },
    "sunken":            { "dark": "#202329", "light": "#e9ebee", "_use": "browser chrome, code blocks, inset strips" },
    "control":           { "dark": "#2c3036", "light": "#e2e5e9", "_use": "segmented tracks, search field, tab container" },
    "selected":          { "dark": "#35393e", "light": "#d5d9df", "_use": "selected sidebar row, selected palette row" },
    "selectedStrong":    { "dark": "#3a3f4b", "light": "#cdd3dc", "_use": "selected tab" },
    "border":            { "dark": "#ffffff14", "light": "#0000001a", "_use": "hairlines around cards, fields and toasts" },
    "textPrimary":       { "dark": "#d7dae0", "light": "#24292f", "_use": "names, titles, focused header" },
    "textSecondary":     { "dark": "#9da5b4", "light": "#57606a", "_use": "tab labels, unfocused header titles, details" },
    "textMuted":         { "dark": "#7f848e", "light": "#8c959f", "_use": "group labels, branches, subtitles, hidden files" },
    "textOnAccent":      { "dark": "#ffffff", "light": "#ffffff", "_use": "text on HUDs, badges and coloured fills" },
    "accent":            { "dark": "#61afef", "light": "#2f7fd8", "_use": "progress bars, matched characters, links" },
    "focus":             { "dark": "#61afef73", "light": "#2f7fd866", "_use": "focus indicator around the focused tile (pending designer confirmation)" },
    "zoom":              { "dark": "#d19a66", "light": "#c4721f", "_use": "focus indicator while the focused tile is zoomed" },

    "statusWorking":     { "dark": "#61afef", "light": "#2f7fd8" },
    "statusBlocked":     { "dark": "#e5c07b", "light": "#b8860b" },
    "statusDone":        { "dark": "#98c379", "light": "#3f8f2f" },
    "statusIdle":        { "dark": "#7f848e", "light": "#8c959f" },
    "statusOff":         { "dark": "#5c6370", "light": "#a0a7b0" },
    "statusConnected":   { "dark": "#98c379", "light": "#3f8f2f" },
    "statusConnecting":  { "dark": "#e5c07b", "light": "#b8860b" },
    "statusReconnecting":{ "dark": "#d19a66", "light": "#c4721f" },
    "statusError":       { "dark": "#e06c75", "light": "#cf222e" },

    "error":             { "dark": "#e06c75", "light": "#cf222e", "_use": "config errors, failed loads" },
    "warning":           { "dark": "#e5c07b", "light": "#b8860b", "_use": "config warnings" },

    "gitModified":       { "dark": "#d19a66", "light": "#c4721f" },
    "gitAdded":          { "dark": "#98c379", "light": "#3f8f2f" },
    "gitDeleted":        { "dark": "#e06c75", "light": "#cf222e" },
    "gitRenamed":        { "dark": "#61afef", "light": "#2f7fd8" },
    "gitConflicted":     { "dark": "#c678dd", "light": "#8250df" },

    "hud":               { "dark": "#000000bf", "light": "#000000bf", "_use": "status HUD in the window corner" },
    "badge":             { "dark": "#0000008c", "light": "#0000008c", "_use": "agent badge pill on tiles" },
    "overlay":           { "dark": "#1b1d23eb", "light": "#1b1d23eb", "_use": "terminal state overlays (reconnecting, ended)" },
    "overlayText":       { "dark": "#bfbfbf", "light": "#bfbfbf" },
    "takeover":          { "dark": "#8c610df2", "light": "#8c610df2", "_use": "read-only / taken-over banner on terminals" },
    "shadow":            { "dark": "#000000", "light": "#000000" },
    "ghostFill":         { "dark": "#8080801a", "light": "#8080801a", "_use": "tile outlines during the outline animation style" },

    "kindTerminal":      { "dark": "#29303d", "light": "#29303d", "_use": "placeholder tile bodies before a tile kind's view exists" },
    "kindBrowser":       { "dark": "#21527a", "light": "#21527a" },
    "kindPreview":       { "dark": "#5c4078", "light": "#5c4078" },
    "kindFiles":         { "dark": "#336145", "light": "#336145" },

    "tabStrip":          { "dark": "#24262c", "light": "#e4e7eb", "_use": "the tab strip's pill container in the toolbar" },
    "tabStripBorder":    { "dark": "#2f3036", "light": "#0000000f", "_use": "hairline around the tab strip" },
    "tabSelected":       { "dark": "#3a3f4b", "light": "#ffffff", "_use": "the selected tab's fill" },
    "tabText":           { "dark": "#9da5b4", "light": "#57606a", "_use": "unselected tab names" },
    "tabTextSelected":   { "dark": "#d7dae0", "light": "#24292f", "_use": "the selected tab's name" },
    "tabAdd":            { "dark": "#6c717a", "light": "#8c959f", "_use": "the tab strip's +" },
    "searchField":       { "dark": "#27292e", "light": "#ffffff", "_use": "toolbar search field" },
    "searchBorder":      { "dark": "#33353a", "light": "#0000001a", "_use": "toolbar search field hairline" },
    "searchBorderActive":{ "dark": "#61afef80", "light": "#2f7fd880", "_use": "search field hairline while quick open is open" },
    "searchText":        { "dark": "#7f848e", "light": "#8c959f", "_use": "search placeholder and magnifier" },
    "searchBadge":       { "dark": "#34363a", "light": "#e9ebee", "_use": "the search field's key badge (⌘K)" },
    "searchBadgeText":   { "dark": "#abb2bf", "light": "#57606a" },
    "titlebarIcon":      { "dark": "#7f848e", "light": "#8c959f", "_use": "sidebar toggle next to the traffic lights" }
  },

  "radius": {
    "_note": "Shipping values. Mockup targets (D.5): tile 10, sidebar card 12. tabStrip/tab/search*: the toolbar (D.2/D.4/D.8, from the mockup).",
    "window": 12,
    "card": 12,
    "tile": 6,
    "focus": 7,
    "terminal": 4,
    "overlay": 4,
    "ghost": 4,
    "row": 5,
    "pill": 6,
    "field": 6,
    "toast": 6,
    "banner": 8,
    "hud": 8,
    "badge": 9,
    "palette": 10,
    "tabStrip": 11,
    "tab": 8,
    "searchField": 8,
    "searchBadge": 4,
    "sidebarSegment": 7
  },

  "border": {
    "_note": "focus: the focused tile's outline (pending designer confirmation); attention: tiles whose agent needs a look.",
    "focus": 1,
    "attention": 2,
    "hairline": 1
  },

  "space": {
    "_note": "Points. Shipping values. Mockup targets (D.5): gutter 8, sidebar width 230. toolbar*/titlebar*/tab*/search*/windowInset: window chrome from the mockup (D.2/D.4/D.8); titlebarLights* is the close button's top-left from the window's top-left, titlebarZone the sidebar card's band for the traffic lights.",
    "gutter": 4,
    "tileInset": 4,
    "cardPadding": 10,
    "headerHeight": 28,
    "headerTitleX": 29,
    "toolbarHeight": 60,
    "windowInset": 8,
    "titlebarZone": 40,
    "titlebarLightsX": 22,
    "titlebarLightsY": 24,
    "titlebarToggleInset": 29,
    "toolbarGap": 14,
    "tabStripHeight": 36,
    "tabStripPadding": 4,
    "tabHeight": 28,
    "tabPaddingX": 10,
    "tabSpacing": 4,
    "tabIconGap": 7,
    "tabMinWidth": 64,
    "tabMaxWidth": 180,
    "searchWidth": 280,
    "searchMinWidth": 170,
    "searchHeight": 30,
    "searchBadgeHeight": 16,
    "rowHeight": 22,
    "sidebarWidth": 230,
    "_sidebar": "Inside the sidebar card (D.3): the side padding of its rows, a workspace row's height, the Agents | Files control and the footer. The card, its inset and its top band are the window chrome's (D.2).",
    "sidebarPadding": 8,
    "sidebarRowHeight": 30,
    "sidebarSegmentHeight": 28,
    "sidebarFooterHeight": 36
  },

  "font": {
    "_note": "UI fonts are the system font; terminals use the user's Ghostty font. weight: regular | medium | semibold | bold. mono: true uses the monospaced system font.",
    "headerTitle":   { "size": 12, "weight": "semibold" },
    "headerSubtitle":{ "size": 12, "weight": "regular" },
    "body":          { "size": 13, "weight": "regular" },
    "row":           { "size": 12, "weight": "regular" },
    "rowSelected":   { "size": 12, "weight": "semibold" },
    "detail":        { "size": 11, "weight": "regular" },
    "caption":       { "size": 10, "weight": "regular" },
    "groupLabel":    { "size": 11, "weight": "regular" },
    "sidebarRow":    { "size": 13, "weight": "regular" },
    "sidebarBranch": { "size": 12, "weight": "regular" },
    "sidebarSegment":{ "size": 12, "weight": "medium" },
    "footerCount":   { "size": 12, "weight": "regular" },
    "dot":           { "size": 8,  "weight": "regular" },
    "addButton":     { "size": 13, "weight": "regular" },
    "badge":         { "size": 11, "weight": "semibold" },
    "badgeLabel":    { "size": 11, "weight": "medium" },
    "hud":           { "size": 12, "weight": "medium" },
    "field":         { "size": 12, "weight": "regular" },
    "paletteField":  { "size": 15, "weight": "regular" },
    "paletteTitle":  { "size": 13, "weight": "regular" },
    "paletteMatch":  { "size": 13, "weight": "bold" },
    "paletteSection":{ "size": 10, "weight": "medium" },
    "palettePrompt": { "size": 11, "weight": "semibold" },
    "chord":         { "size": 11, "weight": "regular", "mono": true },
    "bannerIcon":    { "size": 13, "weight": "bold" },
    "bannerText":    { "size": 11, "weight": "regular", "mono": true },
    "bannerClose":   { "size": 12, "weight": "semibold" },
    "overlayTitle":  { "size": 14, "weight": "semibold" },
    "overlayTitleSmall": { "size": 12, "weight": "semibold" },
    "overlayBody":   { "size": 12, "weight": "regular" },
    "gitBadge":      { "size": 10, "weight": "semibold", "mono": true },
    "monoDetail":    { "size": 11, "weight": "regular", "mono": true },
    "tileLabel":     { "size": 12, "weight": "medium", "mono": true },
    "tab":           { "size": 13, "weight": "regular" },
    "tabSelected":   { "size": 13, "weight": "medium" },
    "search":        { "size": 13, "weight": "regular" },
    "searchBadge":   { "size": 11, "weight": "regular" }
  },

  "status": {
    "_note": "Agent and machine states: SF Symbol plus colour token. Used by the sidebar, tabs, footer and badges.",
    "working":      { "symbol": "progress.indicator",          "color": "statusWorking" },
    "blocked":      { "symbol": "exclamationmark.circle.fill", "color": "statusBlocked" },
    "done":         { "symbol": "checkmark.circle",            "color": "statusDone" },
    "idle":         { "symbol": "circle.dashed",               "color": "statusIdle" },
    "off":          { "symbol": "circle.dotted",               "color": "statusOff" },
    "connected":    { "symbol": "circle.fill",                 "color": "statusConnected" },
    "connecting":   { "symbol": "circle.dotted",               "color": "statusConnecting" },
    "reconnecting": { "symbol": "arrow.triangle.2.circlepath", "color": "statusReconnecting" },
    "error":        { "symbol": "exclamationmark.triangle.fill", "color": "statusError" }
  },

  "icon": {
    "_note": "SF Symbols for tile kinds and palette row kinds.",
    "terminal": "terminal",
    "browser": "globe",
    "preview": "doc.text",
    "files": "folder",
    "command": "command",
    "workspace": "square.stack.3d.up",
    "tab": "rectangle.topthird.inset.filled"
  },

  "motion": {
    "_note": "Milliseconds. Reference values; the [animation] config section owns the live ones.",
    "layout": 200,
    "focus": 120,
    "tabSwitch": 150,
    "outlineFade": 80,
    "revealMax": 250
  }
}
