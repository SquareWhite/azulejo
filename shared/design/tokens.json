    "badge": 9,
    "palette": 10,
    "tabStrip": 11,
    "tab": 8,
    "searchField": 8,
    "searchBadge": 4,
    "sidebarSegment": 7,
    "badgeDot": 4,
    "machineDot": 3
  },
  "border": {
    "_note": "attention: tiles whose agent needs a look. Focus has no border: unfocused tiles dim instead (alpha.unfocusedDim).",
    "attention": 2,
    "hairline": 1
  },
  "alpha": {
    "_note": "Opacities (0 to 1) applied on top of colour tokens, so no view carries its own. bannerMix is how much window colour the config banner's tinted fill is blended with. unfocusedDim is the focus indicator: every unfocused tile (header strip included) gets color.dimFill over it at this opacity, which turns the mockup's focused colours into its unfocused ones (body #282c34 → #252830, mockup #252930; header #21252b → #202329, as sampled). Ghostty's unfocused-split-opacity overrides it (dim = 1 − opacity; Ghostty's own default is 0.3).",
    "attentionBorder": 0.85,
    "workingMarker": 0.6,
    "rowHover": 0.45,
    "footerZero": 0.45,
    "dimmed": 0.5,
    "unfocusedDim": 0.25,
    "badgePulse": 0.35,
    "bannerFill": 0.16,
    "bannerMix": 0.75,
    "bannerBorder": 0.5,
    "browserBanner": 0.95,
    "paletteShadow": 0.35,
    "railAttention": 0.16
  },
  "space": {
    "_note": "Points. gutter is the space between tiles (D.5). tileInset is 0: the window layout (windowInset, D.2) owns the margin round the tile area. tileContentPad is the margin round a terminal's text; browserChromeHeight is the browser toolbar, which replaces the header strip on browser tiles. Sidebar width target 230 (D.3). toolbar*/titlebar*/tab*/search*/windowInset: window chrome from the mockup (D.2/D.4/D.8); titlebarLights* is the close button's top-left from the window's top-left, titlebarZone the sidebar card's band for the traffic lights.",
    "gutter": 8,
    "tileInset": 0,
    "tileContentPad": 8,
    "browserChromeHeight": 36,
    "browserFieldHeight": 24,
    "cardPadding": 10,
    "headerHeight": 28,
    "headerTitleX": 29,
    "toolbarHeight": 60,
    "windowInset": 8,
    "titlebarZone": 40,
    "titlebarLightsX": 22,
    "titlebarLightsY": 24,
    "titlebarToggleInset": 29,
    "toolbarGap": 14,
    "tabStripHeight": 36,
    "tabStripPadding": 4,
    "tabHeight": 28,
    "tabPaddingX": 10,
    "tabSpacing": 4,
