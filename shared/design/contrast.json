  "_accept": "Known failures, listed (KNOWN) but not failing the check, each with why it stays: a design call for the user, not a token to nudge.",
  "accept": [
    {"theme": "macos-light", "pair": "sidebar.selected.fill", "why": "Finder's grey for an unemphasised selection (unemphasizedSelectedContentBackgroundColor), the designer's choice over the accent tint: 1.26:1 on the token's #f5f5f5, lower on the sampled vibrant card; the row's bold name and its icon carry the selection too"},
    {"theme": "macos-dark", "pair": "hints.match.blue", "why": "the pair composites the selection colour under the text, but the highlight adds it (plus-lighter: the background becomes the selection colour, every glyph lifts by the same amount), so #3d8ef0 shows as about #5ed3ff, 3.6:1"},
    {"theme": "atom-one-light", "pair": "sidebar.hint.offline", "why": "as sidebar.name.offline: the badge fades with its offline row at alpha.dimmed (2.55:1, about the name's 2.58:1)"},
    {"theme": "macos-light", "pair": "sidebar.hint.offline", "why": "as sidebar.name.offline: the badge fades with its offline row at alpha.dimmed (2.93:1, about the name's 2.97:1)"},
    {"theme": "macos-light", "pair": "sidebar.name.offline", "why": "as atom-one-light: alpha.dimmed is shared, and half-alpha dark text on a light card loses more contrast"},
    {"theme": "atom-one-light", "pair": "sidebar.name.offline", "why": "offline rows fade at alpha.dimmed, shared by every theme; half-alpha dark text on a light card loses more contrast than light text on a dark one"}
  ],
