#!/usr/bin/env python3
"""Generates the macOS shell's Design.swift from the shared design tokens.

    scripts/design-tokens           # writes apps/macos/Sources/Azulejo/Design.swift
    scripts/design-tokens --check   # exits 1 if that file is stale

Reads shared/design/tokens.json. Keys starting with "_" are notes and are
skipped. Standard library only, deterministic output.
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOKENS = ROOT / "shared" / "design" / "tokens.json"
OUT = ROOT / "apps" / "macos" / "Sources" / "Azulejo" / "Design.swift"

WEIGHTS = {"light", "regular", "medium", "semibold", "bold"}
IDENT = re.compile(r"^[a-z][A-Za-z0-9]*$")


def fail(msg: str) -> None:
    print(f"design-tokens: {msg}", file=sys.stderr)
    sys.exit(2)


def entries(section: dict) -> list[tuple[str, object]]:
    out = []
    for key, value in section.items():
        if key.startswith("_"):
            continue
        if not IDENT.match(key):
            fail(f"token name {key!r} must be lowerCamelCase")
        out.append((key, value))
    return out


def rgba(hex_value: str, where: str) -> str:
    m = re.fullmatch(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?", hex_value)
    if not m:
        fail(f"{where}: {hex_value!r} is not #rrggbb or #rrggbbaa")
    return "0x" + (m.group(1) + (m.group(2) or "ff")).lower()


def number(value: object, where: str) -> str:
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        fail(f"{where}: expected a number, got {value!r}")
    return f"{value:g}"


def generate(tokens: dict) -> str:
    lines: list[str] = []
    add = lines.append
    add("// Generated by scripts/design-tokens from shared/design/tokens.json.")
    add("// Do not edit by hand: change the JSON and run `scripts/design-tokens`.")
    add("// `just lint` fails while this file is stale.")
    add("")
    add("import AppKit")
    add("")
    add("/// Design tokens: colours, radii, spacing, type, status icons and motion.")
    add("/// Use these instead of literal colours, fonts and sizes in the shell.")
    add("enum Design {")

    # Colours
    add("    /// Colours with a dark and a light value, resolved per appearance.")
    add("    enum Color {")
    for name, value in entries(tokens["color"]):
        if not isinstance(value, dict) or "dark" not in value or "light" not in value:
            fail(f"color.{name}: needs dark and light")
        dark = rgba(value["dark"], f"color.{name}.dark")
        light = rgba(value["light"], f"color.{name}.light")
        use = value.get("_use")
        if use:
            add(f"        /// {use}")
        add(f'        static let {name} = dynamic("{name}", dark: {dark}, light: {light})')
    add("")
    add("        private static func dynamic(_ name: String, dark: UInt32, light: UInt32) -> NSColor {")
    add("            let darkColor = rgba(dark), lightColor = rgba(light)")
    add("            return NSColor(name: NSColor.Name(\"azulejo.\" + name)) { appearance in")
    add("                appearance.bestMatch(from: [.darkAqua, .aqua]) == .aqua ? lightColor : darkColor")
    add("            }")
    add("        }")
    add("")
    add("        private static func rgba(_ v: UInt32) -> NSColor {")
    add("            NSColor(srgbRed: CGFloat((v >> 24) & 0xff) / 255, green: CGFloat((v >> 16) & 0xff) / 255,")
    add("                    blue: CGFloat((v >> 8) & 0xff) / 255, alpha: CGFloat(v & 0xff) / 255)")
    add("        }")
    add("    }")
    add("")

    def cgfloat_enum(title: str, doc: str, section: str) -> None:
        add(f"    /// {doc}")
        add(f"    enum {title} {{")
        for name, value in entries(tokens[section]):
            add(f"        static let {name}: CGFloat = {number(value, f'{section}.{name}')}")
        add("    }")
        add("")

    cgfloat_enum("Radius", "Corner radii, in points.", "radius")
    cgfloat_enum("Border", "Border widths, in points.", "border")
    cgfloat_enum("Alpha", "Opacities (0 to 1) applied on top of colour tokens.", "alpha")
    cgfloat_enum("Space", "Spacing and fixed sizes, in points.", "space")
    cgfloat_enum("Symbol", "SF Symbol point sizes.", "symbol")

    # Fonts
    add("    /// UI fonts. Terminals use the user's Ghostty font, not these.")
    add("    enum Font {")
    for name, value in entries(tokens["font"]):
        size = number(value.get("size"), f"font.{name}.size")
        weight = value.get("weight", "regular")
        if weight not in WEIGHTS:
            fail(f"font.{name}: unknown weight {weight!r}")
        if value.get("mono"):
            ctor = f".monospacedSystemFont(ofSize: {size}, weight: .{weight})"
        else:
            ctor = f".systemFont(ofSize: {size}, weight: .{weight})"
        add(f"        nonisolated(unsafe) static let {name}: NSFont = {ctor}")
    add("    }")
    add("")

    # Status
    colours = {name for name, _ in entries(tokens["color"])}
    add("    /// Agent and machine states, each with an SF Symbol and a colour.")
    add("    enum Status: String, CaseIterable, Sendable {")
    status = entries(tokens["status"])
    for name, _ in status:
        add(f"        case {name}")
    add("")
    add("        /// SF Symbol name for the state's icon.")
    add("        var symbol: String {")
    add("            switch self {")
    for name, value in status:
        add(f'            case .{name}: "{value["symbol"]}"')
    add("            }")
    add("        }")
    add("")
    add("        var color: NSColor {")
    add("            switch self {")
    for name, value in status:
        if value["color"] not in colours:
            fail(f"status.{name}: unknown colour {value['color']!r}")
        add(f"            case .{name}: Design.Color.{value['color']}")
    add("            }")
    add("        }")
    add("    }")
    add("")
    add("    enum StatusIcon {")
    add("        /// The state's symbol and colour.")
    add("        static func `for`(_ status: Status) -> (symbol: String, color: NSColor) {")
    add("            (status.symbol, status.color)")
    add("        }")
    add("")
    add("        /// The state's symbol as a tinted image, or nil if the symbol is missing.")
    add("        /// Symbols named `azulejo.*` are drawn by the app (DesignSupport.swift).")
    add("        static func image(_ status: Status, pointSize: CGFloat = 11) -> NSImage? {")
    add("            if status.symbol.hasPrefix(\"azulejo.\") {")
    add("                return Design.customSymbol(status.symbol, color: status.color, pointSize: pointSize)")
    add("            }")
    add("            let config = NSImage.SymbolConfiguration(pointSize: pointSize, weight: .regular)")
    add("                .applying(.init(paletteColors: [status.color]))")
    add("            return NSImage(systemSymbolName: status.symbol, accessibilityDescription: status.rawValue)?")
    add("                .withSymbolConfiguration(config)")
    add("        }")
    add("    }")
    add("")

    # Icons
    add("    /// SF Symbols for tile kinds and quick-open rows.")
    add("    enum Icon {")
    for name, value in entries(tokens["icon"]):
        add(f'        static let {name} = "{value}"')
    add("    }")
    add("")

    # Motion
    add("    /// Reference durations in seconds; the [animation] config owns the live values.")
    add("    enum Motion {")
    for name, value in entries(tokens["motion"]):
        ms = number(value, f"motion.{name}")
        add(f"        static let {name}: TimeInterval = {float(ms) / 1000:g}")
    add("    }")
    add("}")
    add("")
    return "\n".join(lines)


def main() -> None:
    check = "--check" in sys.argv[1:]
    try:
        tokens = json.loads(TOKENS.read_text())
    except json.JSONDecodeError as e:
        fail(f"{TOKENS.relative_to(ROOT)}: {e}")
    for section in ("color", "radius", "border", "alpha", "space", "symbol", "font", "status", "icon", "motion"):
        if section not in tokens:
            fail(f"missing section {section!r}")
    text = generate(tokens)
    if check:
        if not OUT.exists() or OUT.read_text() != text:
            print(f"{OUT.relative_to(ROOT)} is stale: run scripts/design-tokens", file=sys.stderr)
            sys.exit(1)
        return
    OUT.write_text(text)


if __name__ == "__main__":
    main()
