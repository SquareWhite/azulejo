@@ -225,6 +225,19 @@ pub fn build(b: *std.Build) !void {
 
         // We shouldn't have this guard but we don't currently
         // build on macOS this way ironically so we need to fix that.
+        // azulejo: AZJ_RUNTIME_METAL=1 also installs the macOS static lib
+        // directly, since we can't wrap it with `xcodebuild -create-xcframework`,
