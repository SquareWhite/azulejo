+    /// Snapshot styled text without changing selection or using the clipboard.
+    export fn ghostty_surface_read_text_vt(surface: *Surface, sel: Selection) String {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+
+        const screen = core.renderer_state.terminal.screens.active;
+        const selection = sel.core(screen) orelse return .empty;
+        var formatter: terminal.formatter.ScreenFormatter = .init(screen, .{
+            .emit = .vt,
+            .unwrap = false,
+            .trim = true,
+        });
+        formatter.content = .{ .selection = selection };
+        var writer: std.Io.Writer.Allocating = .init(global.alloc());
+        defer writer.deinit();
+        formatter.format(&writer.writer) catch return .empty;
+        const text = writer.toOwnedSlice() catch return .empty;
+        return .fromSlice(text);
+    }
