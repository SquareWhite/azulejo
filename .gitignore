# Rust
/target/

# macOS
.DS_Store
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
apps/macos/.build/
apps/macos/.swiftpm/

# Generated by build.rs (cbindgen)
core/crates/ffi/include/

# Ghostty / Zig
vendor/ghostty/zig-out/
vendor/ghostty/macos/GhosttyKit.xcframework/
.zig-cache/
zig-cache/
zig-out/
*.xcframework/

# Spikes and scripts: build output, cloned deps, captures (may hold screen content)
spikes/*/build/
spikes/*/.build/
spikes/*/.deps/
spikes/*/out/*
scripts/latency/build/
scripts/*/build/

# Python
__pycache__/
.pytest_cache/
*.pyc
.venv/
clients/python/dist/

# Local tooling
.claude-last-session
.claude/settings.local.json
.dev/
/.claude/

# Frozen dogfood builds (docs/dogfooding.md)
/dist/

# Local captures can contain usernames, private projects and screen content.
/docs/testing/**/*.png
/docs/design/*.png
/docs/design/icon/dock-neighbours.png

# Local credentials and signing material; publish examples, never real values.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.ips
*.log
*.bundle
