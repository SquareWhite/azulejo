# The mockup's "agents" workspace, for
# automation/mockup.sh. @FX@ is the fixture folder, @REPO@ this checkout.

name = "azulejo"

[[tab]]
name = "agents"
[tab.root]
split = "horizontal"
sizes = [53, 47]
[[tab.root.children]]
title = "claude"
cwd = "@REPO@"
command = "clear; cat @FX@/claude.txt"
focus = true
[[tab.root.children]]
split = "vertical"
sizes = [50, 50]
[[tab.root.children.children]]
title = "notes"
cwd = "@REPO@"
command = "clear; cat @FX@/0009-pane-exit.md"
[[tab.root.children.children]]
split = "horizontal"
sizes = [50, 50]
children = [
  { title = "server", cwd = "@REPO@", command = "clear; echo 'listening on :5173'" },
  { title = "zsh", cwd = "@REPO@", command = "clear; @FX@/just dogfood" },
]

[[tab]]
name = "review"
tile = [{ title = "claude", cwd = "@REPO@" }]

[[tab]]
name = "release"
tile = [{ title = "claude", cwd = "@REPO@" }]
