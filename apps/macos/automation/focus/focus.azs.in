# Key and focus suite: every scenario checks what a chord
# resolved to (`key.last`) and where first responder ended up (`responder`,
# `responder.focused`), plus the focused tile. Run with focus.sh.
# @DIR@ (fixtures: a small git repo in tree/), @HERE@ (this folder).

log setup
# Keys go the way a key window routes them (router, key equivalents, Edit
# menu, first responder); a posted event in a background run would lose the
# menu's key equivalents.
delivery direct
until responder terminal 10000
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}
expect kind manual

log === S01 the first terminal holds first responder at launch
expect responder terminal
expect responder.focused yes
expect tiles 1

log === S02 plain typing reaches the PTY, not the router
type echo azjfocus
key 1
expect key.last passed
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} azjfocus1
expect responder terminal

log === S03 an app chord in a terminal runs its action (split_auto) and focus follows the new tile
key ctrl+cmd+t
expect key.last action:split_auto
until tiles 2
expect focus 2
until responder.focused yes
# The new pane binds after the split's motion; the surface then takes the keyboard.
until terminal.phase attached 10000
until responder terminal 5000

log === S04 focus by direction moves first responder with it
key alt+h
expect key.last action:focus_tile_left
expect focus 1
until responder.focused yes
expect responder terminal
key alt+l
expect focus 2
until responder.focused yes

log === S05 ctrl+letters go to the PTY (cat -v shows them)
type cat -v
key enter
wait 400
key ctrl+g
expect key.last passed
sh @HERE@/pane-has.sh {herdr} {session} {pane} ^G

log === S06 a typed ctrl+b reaches the PTY once and never starts herdr's detach chord
key ctrl+b
key q
sh @HERE@/pane-has.sh {herdr} {session} {pane} ^Bq
wait 500
expect terminal.phase attached
expect responder terminal

log === S07 ctrl+c reaches the PTY (ends cat)
key ctrl+c
type echo azjfocus
key 7
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} azjfocus7

log === S08 cmd+v pastes through the Edit menu (private pasteboard)
clip set azjpaste42
key cmd+v
expect key.last passed
sh @HERE@/pane-has.sh {herdr} {session} {pane} azjpaste42
key ctrl+u

log === S09 cmd+c copies the terminal selection through the Edit menu
clip clear
surface select-all
expect terminal.selection yes
key cmd+c
expect key.last passed
wait 500
clip has azjfocus7

log === S10 cmd+a is the sidebar in a terminal (context chord); first responder stays
sidebar mode workspaces
expect sidebar visible
key cmd+a
expect key.last action:toggle_agents_sidebar
expect sidebar rail
expect responder terminal
key cmd+a
expect sidebar visible

log === S11 mid-composition, app chords don't fire
ime mark か
expect ime.marked か
key ctrl+cmd+t
expect key.last composing
expect tiles 2
key cmd+k
expect key.last composing
expect palette closed
expect responder terminal

log === S12 the committed composition reaches the PTY as typed text
sh @HERE@/pane-has.sh --not {herdr} {session} {pane} かな
ime commit かな
expect ime.marked -
sh @HERE@/pane-has.sh {herdr} {session} {pane} かな
key ctrl+u
key alt+h
expect key.last action:focus_tile_left
expect focus 1

log === S13 cmd+k over a terminal: typing goes to the menu's field
key cmd+k
expect key.last action:quick_open
expect palette all
expect responder palette
type spl
expect palette.query spl
shot s13-quickopen-over-terminal
sh @HERE@/pane-has.sh --not {herdr} {session} {pane} spl

log === S14 a refresh while the menu is open doesn't take its field away
seen-visible on
wait 300
seen-visible off
wait 300
expect responder palette
type i
expect palette.query spli

log === S15 escape closes the menu and gives first responder back to the terminal
key escape
expect palette closed
expect responder terminal
expect responder.focused yes
expect focus 1

# --- the sidebar's Files view, on a small repo ---
log === S16 the sidebar's Files view takes the keyboard; j / k move the selection there
core {"method":"workspace.set_repo","params":{"path":"@DIR@/tree"}}
sidebar mode files
until sidebar.files.root @DIR@/tree 10000
until sidebar.files.rows 4 5000
sidebar focus
until sidebar.files.keyboard yes 2000
expect sidebar.files.selected sub
key j
expect key.last action:files_down
expect sidebar.files.selected alpha.txt
key j
expect sidebar.files.selected beta.txt
key k
expect sidebar.files.selected alpha.txt
expect sidebar.files.keyboard yes

log === S17 / opens the Files view's filter; typing filters; escape goes back to the tree
key /
expect key.last action:files_filter
type gam
until sidebar.files.rows 1 3000
key escape
until sidebar.files.rows 4 3000
expect sidebar.files.keyboard yes

log === S18 escape hands the keyboard back to the focused terminal
key escape
expect key.last action:files_leave
until responder terminal 3000
expect responder.focused yes
sidebar mode workspaces

# --- focus after layout changes, in a tab of their own: T | V(T / H(T | T)) ---
key cmd+shift+t
expect key.last action:new_tab
until tab 2
until responder terminal 10000
core {"method":"layout.set","params":{"kind":"manual"}}
core {"method":"layout.split","params":{"direction":"right"}}
until tiles 2 5000
core {"method":"layout.split","params":{"direction":"down"}}
until tiles 3 5000
core {"method":"layout.split","params":{"direction":"right"}}
until tiles 4 5000
until terminal.phase attached 10000
until responder terminal 10000

log === S19 closing a tile (manual) hands focus and first responder to its neighbour
expect tiles 4
key alt+w
expect key.last action:close_tile
until tiles 3
until responder terminal 10000
expect responder.focused yes

log === S20 closing in a dynamic Tile layout focuses a tile in the layout, with first responder
core {"method":"layout.set","params":{"kind":"tile"}}
expect kind tile
until responder.focused yes
key alt+w
until tiles 2
until responder.focused yes
remember focused.id

log === S21 in Monocle, focus switches restack without resizes and first responder follows
key alt+z
expect key.last action:toggle_layout_monocle
expect kind monocle
expect visible 1
until responder.focused yes
# Both tiles are terminals: the focused one grows to the tab's size with
# the toggle's motion, so let that land before counting. The other comes
# back in place at the tab's size, so neither switch resizes either.
wait 1500
remember resizes
key alt+l
until responder.focused yes
expect visible 1
unchanged resizes
key alt+l
until responder.focused yes
unchanged focused.id
unchanged resizes

log === S22 closing in Monocle shows the next tile with first responder
key alt+w
until tiles 1
expect visible 1
until responder.focused yes
key alt+z
expect kind tile

log === S23 zoom and unzoom keep first responder in the focused tile
core {"method":"layout.split","params":{"direction":"right"}}
until tiles 2
until terminal.phase attached 10000
until responder terminal 10000
remember responder.tile
key alt+shift+m
expect key.last action:zoom_tile
expect zoomed yes
expect visible 1
expect responder terminal
unchanged responder.tile
key alt+shift+m
expect zoomed no
expect responder terminal
unchanged responder.tile

log === S24 switching tabs and back restores each tab's focused tile and first responder
remember focused.id
key ctrl+1
expect key.last action:switch_tab(1)
expect tab 1
until responder terminal
expect responder.focused yes
expect focus 1
key ctrl+2
expect tab 2
until responder terminal
unchanged focused.id
expect responder.focused yes

log === S25 switching workspaces and back does the same
key cmd+t
expect key.last action:new_workspace
until workspaces 2
until responder terminal 10000
expect responder.focused yes
key cmd+1
expect key.last action:switch_workspace(1)
expect workspace 1
until responder terminal
unchanged focused.id
expect responder.focused yes

# --- focus and herdr ---
log === S26 a pane split in herdr (phone, CLI) arrives as a tile without taking focus
key ctrl+1
until responder terminal
until terminal.phase attached 10000
remember focused.id
remember responder.tile
expect tiles 2
sh {herdr} --session {session} pane split {pane} --direction right >/dev/null
until tiles 3 5000
wait 500
unchanged focused.id
unchanged responder.tile
expect responder terminal

log === S27 a shell that exits closes its tile; the neighbour gets focus and first responder
type exit
key enter
until tiles 2 5000
until responder.focused yes
expect responder terminal

log === S28 taken over by another client: read-only, app chords still work, first responder stays on the tile
until terminal.phase attached 10000
remember focused.id
sh python3 @HERE@/takeover.py {herdr} {session} {pane} 6 >/dev/null 2>&1 &
until terminal.phase observing-taken-over 8000
expect responder terminal-ro
shot s36-taken-over
expect responder.focused yes
type xyz
expect key.last passed
key alt+l
expect key.last action:focus_tile_right
until responder.focused yes
key alt+h
until responder terminal-ro
unchanged focused.id

log === S29 take back: the tile is writable again and holds first responder
terminal takeover
until terminal.phase attached 8000
until responder terminal
expect responder.focused yes

log === S30 a config error banner doesn't take first responder
remember responder.tile
sh printf 'this line = = is broken\n' >> '{config}'
until banner.shown yes 5000
expect responder terminal
unchanged responder.tile
type echo azjbanner
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} azjbanner
sh sed -i '' '$d' '{config}'
until banner.shown no 5000
expect responder terminal

# --- find (⇧⌘F) in a terminal, in a tab of its own ---
key cmd+shift+t
until tab 3
until responder terminal 10000
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}

log === S31 cmd+shift+f in a terminal opens its find bar with the keyboard in it
# The shell prints the markers; the command line itself doesn't hold them.
type echo azj''needle; echo azj''twin; echo azj''twin
key enter
type seq 1 150
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} 150
key cmd+shift+f
expect key.last action:find
expect responder terminal-find
expect responder.focused yes
expect tile.find open

log === S32 typing in the bar searches herdr's history and scrolls the match into view, highlighted
type azjneedle
expect key.last passed
until tile.find.status 1 of 1 5000
until tile.find.revealed yes
expect tile.find.query azjneedle
expect responder terminal-find
# libghostty marks the occurrence herdr now shows.
until tile.find.highlights 1
capture s40-find-terminal 300
wait 500

log === S33 herdr refreshes and app refreshes leave the keyboard in the bar
sh {herdr} --session {session} pane rename {pane} azjfind >/dev/null
seen-visible on
wait 300
seen-visible off
wait 300
expect responder terminal-find
type x
expect tile.find.query azjneedlex
until tile.find.status No matches 5000
# Nothing typed in the bar reached the PTY.
sh @HERE@/pane-has.sh --not {herdr} {session} {pane} azjneedlex
key backspace
until tile.find.status 1 of 1 5000

log === S34 enter and shift+enter step through the matches, newest first; cmd+a stays in the bar
key cmd+a
expect key.last passed
expect sidebar visible
type azjtwin
until tile.find.status 1 of 2 5000
key enter
expect key.last find
expect tile.find.status 2 of 2
key enter
expect tile.find.status 1 of 2
key shift+enter
expect tile.find.status 2 of 2
expect responder terminal-find

log === S35 escape closes the bar, gives the keyboard back to the terminal and the view to the bottom
key escape
expect key.last find
expect tile.find closed
expect responder terminal
expect responder.focused yes
until tile.find.scroll 0
type echo azjafter
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} azjafter

log === S36 cmd+shift+f again reopens the bar with the last query, searched afresh
key cmd+shift+f
expect responder terminal-find
expect tile.find.query azjtwin
until tile.find.status 1 of 2 5000
key escape
expect responder terminal

# --- an open find bar gets the keyboard back when its tile does, in a tab of its own ---
key cmd+shift+t
until tab 4
until responder terminal 10000
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}

log === S37 cmd+k then escape over a terminal's open find bar: the keyboard goes back to the bar
type echo azj''needle
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} azjneedle
key cmd+shift+f
expect responder terminal-find
type azjneedle
until tile.find.status 1 of 1 5000
key cmd+k
expect palette all
expect responder palette
key escape
expect palette closed
expect tile.find open
expect responder terminal-find
expect responder.focused yes
type q
expect tile.find.query azjneedleq
sh @HERE@/pane-has.sh --not {herdr} {session} {pane} azjneedleq
key backspace
expect tile.find.query azjneedle

log === S38 a tab switch and back with a terminal's bar open: the bar gets the keyboard back
key ctrl+3
expect tab 3
until responder.focused yes
key ctrl+4
expect tab 4
expect tile.find open
until responder terminal-find 2000
type r
expect tile.find.query azjneedler
sh @HERE@/pane-has.sh --not {herdr} {session} {pane} azjneedler
key backspace
# Escape still closes the bar and gives the terminal back.
key escape
expect tile.find closed
expect responder terminal

log === S39 terminal keys reach the pane's program as bytes: shift+enter is CSI 13;2u under the kitty keyboard protocol (what Claude Code and fish ask for), enter stays \r, cmd+l types ctrl+l (send_text)
key cmd+shift+t
until terminal.phase attached 10000
until responder terminal 5000
sh {herdr} --session {session} pane run {pane} "python3 @HERE@/keyecho.py 1 30"
sh @HERE@/pane-has.sh {herdr} {session} {pane} "(kitty flags 1)"
key shift+enter
expect key.last passed
sh @HERE@/pane-has.sh {herdr} {session} {pane} "got 1b5b31333b3275"
key enter
sh @HERE@/pane-has.sh {herdr} {session} {pane} "got 0d"
key cmd+l
expect key.last action:send_text
sh @HERE@/pane-has.sh {herdr} {session} {pane} "got 0c"
key q
expect responder terminal
quit
