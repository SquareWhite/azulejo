# Every keymap context rebinds live: one key in each of palette, find_bar,
# resize and files (the sidebar's Files view) moves to a new chord through
# the dev profile's config file. Without a restart the new chord works and the old
# one doesn't; "" and "none" unbind; copying the old file back restores the
# defaults; and "Open config file" writes the commented template when the
# file is missing. Run with rebind.sh.
# @DIR@ (fixtures: rebind.toml and a small git repo in tree/), @AZJ@ (azj
# on this instance's socket).

log setup
delivery direct
until responder terminal 10000
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}
sh cp {config} {config}.orig
# terminal | terminal, and the sidebar's Files view on a small repo
core {"method":"layout.split","params":{"direction":"right"}}
until tiles 2 5000
until terminal.phase attached 10000
key alt+h
until responder terminal 5000
core {"method":"workspace.set_repo","params":{"path":"@DIR@/tree"}}
sidebar mode files
until sidebar.files.root @DIR@/tree 10000
until sidebar.files.rows 4 5000
sidebar focus
until sidebar.files.keyboard yes 2000
expect sidebar.files.selected sub

log === R01 the defaults, context by context
# files: j moves, . shows hidden files, escape goes back to the tiles
key j
expect key.last action:files_down
expect key.context files
expect sidebar.files.selected alpha.txt
key period
expect key.last action:files_toggle_hidden
until sidebar.files.hidden shown 3000
key period
until sidebar.files.hidden hidden 3000
key escape
expect key.last action:files_leave
until responder terminal 3000
# find_bar: escape closes the bar
key cmd+shift+f
until tile.find open 3000
expect key.context terminal
key escape
expect key.last find
expect key.context find_bar
expect tile.find closed
# palette: down / up move the selection (start without the recents an
# earlier run on this dev instance left)
palette forget
key cmd+k
expect palette all
expect palette.index 0
key down
expect key.last palette
expect key.context palette
expect palette.index 1
key up
expect palette.index 0
key escape
expect palette closed
# resize: ctrl+alt+r, then l grows the terminal, escape ends it
key alt+h
until responder terminal 5000
expect ratio 0.50
key ctrl+alt+r
expect keys.resizing yes
key l
expect key.context resize
expect ratio 0.55
key escape
expect keys.resizing no
shot r01-defaults

log === R02 rebind one key per context in the config file; it reloads on save
sh cat @DIR@/rebind.toml >> {config}
until quickopen.chord ⌘J 5000
expect banner.shown no
sh @AZJ@ --json config keys > {out}/keys-rebound.json

log === R03 resize: d grows now, l does nothing, escape no longer ends it (q does)
expect responder terminal
key ctrl+alt+r
expect keys.resizing yes
key l
expect ratio 0.55
expect keys.resizing yes
key d
expect ratio 0.60
key escape
expect keys.resizing yes
key q
expect keys.resizing no
key alt+h
expect key.last action:focus_tile_left

log === R04 terminal: shift+enter types "\n" (send_text); cmd+l is a key again ("" unbinds its text)
expect responder terminal
key shift+enter
expect key.last action:send_text
key cmd+l
expect key.last passed
expect responder terminal

log === R05 palette: cmd+j opens it, ctrl+down moves, down and up don't
key cmd+k
expect key.last passed
expect palette closed
key cmd+j
expect key.last action:quick_open
expect palette all
expect palette.index 0
key down
expect key.last palette-field
expect palette.index 0
key ctrl+down
expect key.last palette
expect palette.index 1
key up
expect key.last palette-field
expect palette.index 1
key escape
expect palette closed

log === R06 find_bar: ctrl+g closes the bar, escape doesn't
key cmd+shift+f
until tile.find open 3000
key escape
expect key.last passed
expect tile.find open
key ctrl+g
expect key.last find
expect tile.find closed

log === R07 files: n moves, j doesn't; . is unbound ("")
sidebar focus
until sidebar.files.keyboard yes 2000
expect sidebar.files.selected alpha.txt
key j
expect key.last passed
expect sidebar.files.selected alpha.txt
key n
expect key.last action:files_down
expect sidebar.files.selected beta.txt
key period
expect key.last passed
wait 300
expect sidebar.files.hidden hidden
shot r08-rebound

log === R08 the old file back: the defaults return without a restart
sh cp {config}.orig {config}
until quickopen.chord ⌘K 5000
key j
expect key.last action:files_down
expect sidebar.files.selected gamma.txt
key cmd+j
expect key.last passed

log === R09 open_config writes the commented template when the file is missing
sh mv {config} {config}.moved
wait 500
action open_config
sh test -s {config}
sh cp {config} {out}/created-config.toml
sh @AZJ@ config defaults > {out}/defaults.toml
sh mv {config}.moved {config}
until quickopen.chord ⌘K 5000
