# showcase.sh's part, run after mockup.azs has built the scene
# (AZJ_MOCKUP_TAIL). @WORK@ is showcase.sh's fixture folder, @FX@ the
# mockup's. The block between @EACH_THEME@ and @END_THEME@ runs once per
# built-in theme with @THEME@ filled in. Every view is captured with
# `capture NAME 0`, and `captured` waits for the PNG before the next change.

log === showcase: the sample-api workspace, for ⌘S and the Files view
delivery direct
anim enabled false
sidebar select 4
until workspace.active sample-api 3000
core {"method":"workspace.set_repo","params":{"path":"@WORK@/sample-api"}}
core {"method":"layout.apply","params":{"path":"@WORK@/sample-api.toml","mode":"replace_tab"}}
until tabs 2 8000
action switch_tab 1
wait 2500
sh {herdr} --session {session} pane report-agent {pane} --source azj-showcase --agent claude --state working
wait 500
sh {herdr} --session {session} pane report-agent {pane} --source azj-showcase --agent claude --state working
wait 800

@EACH_THEME@
log === @THEME@
theme set @THEME@
until theme @THEME@ 5000
wait 1500

log --- hero: the mockup scene (azulejo, tab "agents"), sidebar on Workspaces
sidebar mode workspaces
sidebar select 1
until workspace.active azulejo 3000
action switch_tab 1
wait 1500
capture @THEME@-hero 0
captured

log --- ⌘ held alone: each row's ⌘N badge (handed to the app in-process)
sidebar hints key on
sidebar hints cmd
until sidebar.hints.pending no 1000
wait 300
capture @THEME@-sidebar-hints 0
captured
sidebar hints none

log --- the sidebar collapsed to its rail: icons only; ⌘ held, the badges; a row's hover card
action toggle_sidebar
until sidebar rail 3000
wait 800
capture @THEME@-sidebar-rail 0
captured
sidebar hints cmd
until sidebar.hints.pending no 1000
expect rail.hints.placed yes
wait 300
capture @THEME@-sidebar-rail-hints 0
captured
sidebar hints none
until rail.hints hidden 1000
sidebar hints key off
sidebar rail hover 2
wait 300
capture @THEME@-sidebar-rail-hover 0
captured
sidebar rail hover 0
sidebar rail group 3
wait 300
capture @THEME@-sidebar-rail-machine 0
captured
sidebar rail hover 0

log --- a short window: the rail and the full sidebar overflow
window-size 1440 480
wait 800
capture @THEME@-sidebar-rail-overflow 0
captured
sidebar rail scroll bottom
wait 300
capture @THEME@-sidebar-rail-overflow-end 0
captured
sidebar rail scroll top
action toggle_sidebar
until sidebar visible 3000
wait 800
sidebar scroll top
wait 300
capture @THEME@-sidebar-overflow 0
captured
sidebar scroll bottom
wait 300
capture @THEME@-sidebar-overflow-end 0
captured
sidebar scroll top
window-size 1440 900
wait 800

log --- the narrowest sidebar: state words fold to icons
sidebar width drag 180 200
wait 600
capture @THEME@-sidebar-narrow 0
captured
sidebar width double
wait 600

log --- ⌘K: the menu, a typed query, > commands, @ jump, Set theme…
palette forget
palette open
wait 600
capture @THEME@-quick-open 0
captured
palette type upl
wait 500
capture @THEME@-quick-open-query 0
captured
palette type >
wait 500
capture @THEME@-quick-open-commands 0
captured
palette type @
wait 500
capture @THEME@-quick-open-jump 0
captured
palette close
until palette closed 3000
palette open >
palette type set theme
wait 300
palette key enter
until palette list:themes 3000
wait 600
capture @THEME@-quick-open-theme 0
captured
palette key escape
until palette closed 3000
until theme @THEME@ 3000

log --- sample-api: Workspaces, then Files with folders open
sidebar select 4
until workspace.active sample-api 3000
action switch_tab 1
wait 1500
capture @THEME@-workspace 0
captured
sidebar mode files
until sidebar.files.root @WORK@/sample-api 5000
wait 800
sidebar focus
sidebar files select src
key l
wait 600
sidebar files select src/upload
key l
wait 600
sidebar files select tests
key l
wait 600
sidebar files select tests/upload
key l
wait 600
sidebar files select src/upload/retry.ts
wait 800
capture @THEME@-sidebar-files 0
captured
key escape
sidebar mode workspaces
wait 800

log --- ⌘S smart select: every kind labelled, then paths only
key cmd+s
until hints.state choosing 3000
wait 600
capture @THEME@-smart-select 0
captured
key p
wait 600
capture @THEME@-smart-select-paths 0
captured
key escape
until hints.state closed 3000
wait 500
@END_THEME@

theme set atom-one-dark
anim enabled default
quit
