# Slow folders never freeze the app. files-slow.sh fills in @BIG@ (20,000
# files, sub/ and repo/, a small git repo) and @SMALL@ (two files), both git
# repos so the sidebar's Files view can be pointed at them
# (`workspace.set_repo`), and holds every folder listing back
# (AZJ_FILES_LIST_DELAY_MS, 2.5 s by default). Each step below needs the main
# thread: one that waited for a listing would only run once the rows were
# in, and the "still loading" checks would fail.

log start
core {"method":"workspace.set_repo","params":{"path":"@BIG@"}}
sidebar mode files
until sidebar.files.loading yes 5000
expect sidebar.files.rows 0
# Round trips through the core and keys on the empty tree, meanwhile.
core {"method":"session.get"}
sidebar focus
key j
key k
wait 800
expect sidebar.files.loading yes
expect sidebar.files.rows 0
shot 01-loading
until sidebar.files.loading no 10000
# Folders first: repo, sub, then the 20,000 files.
expect sidebar.files.root @BIG@
expect sidebar.files.rows 20002
expect sidebar.files.names repo,sub,f00000.txt,f00001.txt,f00002.txt,f00003.txt,f00004.txt,f00005.txt,f00006.txt,f00007.txt,f00008.txt,f00009.txt
shot 02-listed

# A folder opens at once; its rows land when its listing does.
sidebar files select sub
key l
wait 500
expect sidebar.files.rows 20002
expect sidebar.files.selected sub
key k
expect sidebar.files.selected repo
until sidebar.files.rows 20102 6000
expect sidebar.files.selected repo

# A new root while a folder listing is held back: the old listing is
# dropped when it lands, the new root's rows stay.
sidebar files select repo
key l
core {"method":"workspace.set_repo","params":{"path":"@SMALL@"}}
until sidebar.files.root @SMALL@ 10000
expect sidebar.files.rows 2
wait 3000
expect sidebar.files.root @SMALL@
expect sidebar.files.rows 2
expect sidebar.files.names a.txt,b.txt
shot 03-new-root
sidebar mode workspaces
quit
