# Drops on terminal tiles (TerminalDrop). drop.sh fills @FX@ (fixtures, with
# expect/<case>: what each drop should type), @HERE@ (e2e/) and @DROPS@ (the
# app's folder for dropped images). pastecap.py in the pane records the bytes
# that reach the PTY; drop-check.py compares them and empties the capture.
log drop suite
delivery direct
seen-visible off
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}
clip clear
remember drop.dir

log --- bracketed paste off
# The pane's folder (where the move zone sends files): herdr reports it.
sh {herdr} --session {session} pane run {pane} "cd @FX@/dest"
until terminal.cwd @FX@/dest 10000
sh {herdr} --session {session} pane run {pane} "python3 @HERE@/pastecap.py @FX@/cap.bin off 300"
sh @HERE@/../focus/pane-has.sh {herdr} {session} {pane} 'pastecap ready'

log === D01 one file: its escaped absolute path
drop files @FX@/plain.txt
expect drop.op dropped
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/single off

log === D02 a path with spaces, quotes, brackets, $ and unicode: escaped as Ghostty.app does
drop files @FX@/it's a "quoted" (file) & ünï 文件 $x [1].txt
expect drop.op dropped
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/tricky off

log === D03 several files: their paths, space-separated, in order
drop files @FX@/plain.txt|@FX@/it's a "quoted" (file) & ünï 文件 $x [1].txt|@FX@/other file.md
expect drop.op dropped
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/several off

log === D04 image data with no file: a PNG in the app's drop folder, and its path
drop image @FX@/shot.png
expect drop.op dropped
sh @HERE@/drop-check.py --image @FX@/cap.bin @DROPS@ @FX@/shot.png off

log === D05 TIFF image data becomes a PNG too
drop image @FX@/shot.tiff
sh @HERE@/drop-check.py --image @FX@/cap.bin @DROPS@ @FX@/shot.png off

log === D06 an image off a web page (data and its URL): the image, not the URL
drop web-image @FX@/shot.tiff https://example.com/shot.tiff
sh @HERE@/drop-check.py --image @FX@/cap.bin @DROPS@ @FX@/shot.png off

log === D07 plain text, as it is
drop text hello from a drop
expect drop.op dropped
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/text off

log === D07b text over two lines with bracketed paste off still arrives
drop text line one\nline two
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/lines off

log === D08 a URL, as text
drop url https://example.com/a?b=1&c=2
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/url off

log === D09 a drag of text that hovers shows the highlight, and loses it when it leaves
drop hover text hello from a drop
expect drop.op copy
expect drop.highlight 1
expect drop.zones none
shot d09-drop-highlight
drop leave
expect drop.highlight none
sh @HERE@/drop-check.py @FX@/cap.bin /dev/null off

log === D10 a drag of something a terminal doesn't take (a tile, say): refused, no highlight
drop hover custom tile
expect drop.op none
expect drop.highlight none
drop custom tile
expect drop.op refused
sh @HERE@/drop-check.py @FX@/cap.bin /dev/null off

log === D11 drops never touch the clipboard
expect clipboard -

log === Z01 a drag of files splits the tile: move into the pane's folder on top, paste below
drop hover files @FX@/src/one.txt
expect drop.op copy
expect drop.highlight none
expect drop.zones move,paste
expect drop.zone paste
expect drop.geometry stacked inset=12 gap=8
expect drop.label.move Drop to|move into @FX@/dest
expect drop.label.paste Drop to|paste path
expect drop.icon.move arrow.forward.folder
expect drop.icon.paste character.cursor.ibeam
drop at 0.5,0.2 hover files @FX@/src/one.txt|@FX@/src/two.txt
expect drop.zone move
expect drop.op move
expect drop.label.paste Drop to|paste paths
wait 300
shot z01-zones-dark
drop at 0.5,0.7 hover files @FX@/src/one.txt
expect drop.zone paste
expect drop.op copy

log === Z02 holding ⌥ copies instead, and the label and icon say so live
drop copy at 0.5,0.2 hover files @FX@/src/one.txt
expect drop.zone move
expect drop.op copy
expect drop.label.move Drop to|copy into @FX@/dest
expect drop.icon.move doc.on.doc
wait 300
shot z02-zones-copy-dark
# ⌥ alone, from a source that leaves the mask as it was: the app goes by
# the key it reads as held (automation's, never the keyboard's).
drop alt at 0.5,0.2 hover files @FX@/src/one.txt
expect drop.zone move
expect drop.op copy
expect drop.label.move Drop to|copy into @FX@/dest
expect drop.icon.move doc.on.doc
drop at 0.5,0.2 hover files @FX@/src/one.txt
expect drop.label.move Drop to|move into @FX@/dest
expect drop.icon.move arrow.forward.folder
theme set atom-one-light
wait 300
shot z02-zones-light
theme set atom-one-dark
drop leave
expect drop.zones none
expect drop.highlight none

log === Z03 a drop on the move zone moves the file into the pane's folder; nothing is typed
drop at 0.5,0.2 files @FX@/src/one.txt
expect drop.op dropped
until drop.transfer done 5000
expect drop.transfer.dests one.txt
expect hud.last Moved one.txt to @FX@/dest
sh test -f @FX@/dest/one.txt && test ! -e @FX@/src/one.txt
sh @HERE@/drop-check.py @FX@/cap.bin /dev/null off
expect drop.zones none

log === Z04 a name the folder already has gets Finder's number; nothing is overwritten
drop at 0.5,0.2 files @FX@/src/clash.txt
until drop.transfer done 5000
expect drop.transfer.dests clash 2.txt
expect hud.last Moved clash.txt to @FX@/dest as clash 2.txt
sh grep -qx new "@FX@/dest/clash 2.txt" && grep -qx old @FX@/dest/clash.txt
sh test ! -e @FX@/src/clash.txt

log === Z05 with ⌥, a file and a folder are copied; the originals stay
drop copy at 0.5,0.2 files @FX@/src/two.txt|@FX@/src/folder
until drop.transfer done 5000
expect drop.transfer.dests two.txt|folder
expect hud.last Copied 2 items to @FX@/dest
sh test -f @FX@/src/two.txt && test -f @FX@/src/folder/inner.md
sh grep -qx two @FX@/dest/two.txt && grep -qx inner @FX@/dest/folder/inner.md
sh @HERE@/drop-check.py @FX@/cap.bin /dev/null off

log === Z06 files dropped on the paste half (the bottom) still type their paths
drop at 0.5,0.8 files @FX@/src/two.txt
expect drop.op dropped
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/two off
sh test -f @FX@/src/two.txt

log --- bracketed paste on
key ctrl+c
sh {herdr} --session {session} pane run {pane} "python3 @HERE@/pastecap.py @FX@/cap.bin on 300"
sh @HERE@/../focus/pane-has.sh {herdr} {session} {pane} 'pastecap ready (bracketed on)'

log === D12 one file, as a bracketed paste
drop files @FX@/plain.txt
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/single on

log === D13 several files, as one bracketed paste
drop files @FX@/plain.txt|@FX@/it's a "quoted" (file) & ünï 文件 $x [1].txt|@FX@/other file.md
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/several on

log === D14 image data, as a bracketed paste of its PNG's path
drop image @FX@/shot.png
sh @HERE@/drop-check.py --image @FX@/cap.bin @DROPS@ @FX@/shot.png on

log === D15 text over two lines, as one bracketed paste
drop text line one\nline two
sh @HERE@/drop-check.py @FX@/cap.bin @FX@/expect/lines on

log --- two tiles
key ctrl+c
key ctrl+cmd+t
until tiles 2 3000
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane:2} "python3 @HERE@/pastecap.py @FX@/cap2.bin off 300"
sh @HERE@/../focus/pane-has.sh {herdr} {session} {pane:2} 'pastecap ready'
key alt+h
until focus 1

log === D16 a drop on an unfocused tile focuses it and types there
drop @2 hover text dropped on tile two
expect drop.highlight 2
drop @2 text dropped on tile two
expect drop.op dropped
until focus 2
until responder.focused yes
expect responder terminal
sh @HERE@/drop-check.py @FX@/cap2.bin @FX@/expect/focus off
expect drop.highlight none
key ctrl+c

log === Z07 a pane whose folder is gone: only the paste zone
sh {herdr} --session {session} pane run {pane:2} "cd @FX@/gone"
until terminal.cwd @FX@/gone 10000
sh rmdir @FX@/gone
drop @2 hover files @FX@/src/two.txt
expect drop.zones paste
expect drop.geometry single inset=12
expect drop.label.paste Drop to|paste path
expect drop.label.move -
expect drop.icon.paste character.cursor.ibeam
expect drop.icon.move -
drop @2 at 0.5,0.2 hover files @FX@/src/two.txt
expect drop.zone paste
expect drop.op copy
wait 300
shot z07-paste-only
drop @2 leave
expect drop.zones none

log === Z08 a short tile: the cards keep their labels and drop their icons
window-size 900 280
drop @1 at 0.5,0.2 hover files @FX@/src/two.txt
expect drop.zones move,paste
expect drop.zone move
expect drop.label.move Drop to|move into @FX@/dest
expect drop.icon.move hidden
expect drop.icon.paste hidden
wait 300
shot z08-short-tile
drop @1 leave
expect drop.zones none
