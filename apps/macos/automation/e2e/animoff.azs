# B4: [animation] enabled = false makes layout changes instant.
log B4 animation off
delivery direct
until terminal.phase attached 10000
anim reset
key ctrl+cmd+t
capture off-split-30 30
wait 600
capture off-split-end 0
wait 300
key alt+shift+m
capture off-zoom-30 30
wait 600
capture off-zoom-end 0
wait 300
anim stats off-stats
# The ⌘K menu shows and hides at once too.
key cmd+k
expect palette all
expect palette.motion none
expect palette.visible yes
expect palette.anims 0
key escape
expect palette closed
expect palette.visible no
# Motion on, with no display-link ticks (`anim no-frames` stands in for a
# sleeping display): motion still ends on time, on wall-clock time, and
# `motion` turns still rather than staying "moving: reveal".
anim enabled true
anim no-frames true
key alt+shift+m
until motion still 2000
expect zoomed no
key ctrl+cmd+t
until tiles 3 3000
until motion still 2000
key alt+z
until motion still 2000
expect kind monocle
key alt+z
until motion still 2000
expect kind tile
key cmd+t
until workspaces 2 5000
until motion still 2000
key cmd+1
until workspace 1 2000
until motion still 2000
anim no-frames false
anim enabled default
