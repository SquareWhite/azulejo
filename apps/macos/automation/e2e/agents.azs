# B5: agent supervision. Four terminals; herdr reports one blocked, one
# working, one idle. Every indicator must follow within 1 s. Tile headers
# carry no badge, only the blocked icon on blocked tiles. Then
# subscription churn, reading (blocked stays; a done mark clears once its
# tile has been in front for the dwell), and the working ring with motion on
# and off.
log B5 agents
delivery direct
seen-visible off
until terminal.phase attached 10000
key ctrl+cmd+t
key ctrl+cmd+t
key ctrl+cmd+t
until tiles 4 3000
wait 2000
# Warm up herdr's agent subscriptions (they open once each tile is bound).
sh for p in {pane:1} {pane:2} {pane:3}; do {herdr} --session {session} pane report-agent $p --source e2e --agent claude --state idle; done
wait 400
sh for p in {pane:1} {pane:2} {pane:3}; do {herdr} --session {session} pane report-agent $p --source e2e --agent claude --state idle; done
until agents idle,idle,idle,none 5000
key alt+l
# Focus is on tile 4 (no agent). Now the timed reports: each `until` has 1 s.
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state working
until agents idle,working,idle,none 1000
sh {herdr} --session {session} pane report-agent {pane:1} --source e2e --agent claude --state blocked
until agents blocked!,working,idle,none 1000
until tab.statuses blocked 1000
until sidebar.statuses blocked 1000
until sidebar.footer working=0,blocked=1,idle=0,done=0 1000
until dock 1 1000
until tab.markers ●1 1000
until sidebar.markers ●1 1000
# Tile headers: no badge for working or idle agents; the blocked tile shows
# the blocked icon alone (`[appearance] tile_agent_badge` is off).
expect tile.badge.setting off
expect header.agents blocked,none,none,none
wait 300
shot 01-blocked-working-idle
# --- subscription churn: tiles come and go while states change ---
key ctrl+cmd+t
sh {herdr} --session {session} pane report-agent {pane:3} --source e2e --agent codex --state working
key alt+w
key ctrl+cmd+t
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state blocked
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state working
key ctrl+cmd+t
sh {herdr} --session {session} pane report-agent {pane:3} --source e2e --agent codex --state blocked
key alt+w
key alt+w
until tiles 4 3000
until agents blocked!,working,blocked!,none 2000
expect dock 2
# --- looking doesn't answer a blocked agent (F11) ---
# The window counts as in front from here (automation runs it behind).
seen-visible on
expect focus 4
key alt+k
expect focus 3
wait 1200
expect agents blocked!,working,blocked!,none
key alt+h
expect focus 1
wait 1200
expect agents blocked!,working,blocked!,none
expect header.agents blocked,none,blocked,none
expect sidebar.statuses blocked
# Answered (back to work): the mark goes with the state change.
sh {herdr} --session {session} pane report-agent {pane:3} --source e2e --agent codex --state working
until agents blocked!,working,working,none 2000
# --- a finished agent's done mark clears once it's read (F11) ---
# Quiet the other agents (herdr keeps them as unknown) so the workspace
# shows the finish.
sh {herdr} --session {session} pane release-agent {pane:1} --source e2e --agent claude
sh {herdr} --session {session} pane release-agent {pane:3} --source e2e --agent codex
until agents unknown,working,unknown,none 3000
# Tile 2 finishes while tile 1 has focus: done everywhere, and it stays.
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state idle
until tab.statuses done 1000
until sidebar.statuses done 1000
wait 1200
expect focus 1
expect tab.statuses done
expect sidebar.statuses done
expect sidebar.footer working=0,blocked=0,idle=0,done=1
expect tab.markers ●1
expect sidebar.markers ●1
shot 02-done-unread
# Reading it: focus tile 2 (through tile 3), hold for the dwell.
key alt+l
key alt+k
expect focus 2
wait 250
expect tab.statuses done
until tab.statuses idle 2000
expect sidebar.statuses idle
expect sidebar.footer working=0,blocked=0,idle=1,done=0
expect tab.markers -
expect sidebar.markers -
# A new run that finishes while the user is already looking: the mark
# shows, then clears after the dwell.
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state working
until tab.statuses working 1000
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state idle
until tab.statuses done 1000
wait 200
expect tab.statuses done
until tab.statuses idle 2000
# Passing through doesn't count as reading.
key alt+j
expect focus 3
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state working
until tab.statuses working 1000
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent claude --state idle
until tab.statuses done 1000
key alt+k
expect focus 2
wait 150
key alt+j
expect focus 3
wait 1200
expect tab.statuses done
# The collapsed rail shows it too, and drops it once read.
action toggle_sidebar
until sidebar rail 3000
wait 600
expect rail.rows 1:done*
key alt+k
expect focus 2
until rail.rows 1:idle* 2000
action toggle_sidebar
until sidebar visible 3000
seen-visible off
# --- working ring: turns while motion is on ---
sh {herdr} --session {session} pane report-agent {pane:1} --source e2e --agent claude --state working
sh {herdr} --session {session} pane report-agent {pane:3} --source e2e --agent codex --state working
until sidebar.statuses working 2000
wait 300
capture ring-on-a 0
wait 310
capture ring-on-b 0
wait 300
# …and holds still with motion off (the same switch Reduce Motion flips).
anim enabled false
sh for p in {pane:1} {pane:2} {pane:3}; do {herdr} --session {session} pane report-agent $p --source e2e --agent claude --state blocked; done
until sidebar.statuses blocked 2000
sh for p in {pane:1} {pane:2} {pane:3}; do {herdr} --session {session} pane report-agent $p --source e2e --agent claude --state working; done
until sidebar.statuses working 2000
wait 300
capture ring-off-a 0
wait 310
capture ring-off-b 0
wait 300
anim enabled default
shot 03-end
