# N1–N6 (e2e 11-04): the features the Nov 3 fixes added, and the places where
# several fixes meet: the find bar (⇧⌘F) under motion, a herdr restart, ⌘K and a
# tab switch; `azj files open` from a terminal; error wording in the HUD;
# agent state in the header (a status icon by default, the badge on
# request); tab overflow; the config banner row.
# fixes.sh fills @FX@ (fixtures), @AZJ@, @OUT@ and @HD@ (e2e/hd).
log N fixes suite
delivery direct
seen-visible off
window-size 1440 900
until terminal.phase attached 10000

# ---------------------------------------------------------------- tab 1 (Tile)
type echo azj''needle; seq 1 60
key enter
sh @HERE@/../focus/pane-has.sh {herdr} {session} {pane} 60
key ctrl+cmd+t
until tiles 2 3000
until terminal.phase attached 10000
key alt+h
expect focus 1

log === N1a the find bar keeps its query and the keyboard through layout motion
key cmd+shift+f
expect key.last action:find
expect responder terminal-find
type azjneedle
until tile.find.status 1 of 1 5000
capture n1a-before 0
anim duration 1500
key alt+backslash
capture n1a-cycle-mid 600
until motion still
expect tile.find open
expect tile.find.query azjneedle
expect responder terminal-find
key alt+backslash
until motion still
key alt+t
until motion still
expect responder terminal-find
key alt+shift+l
capture n1a-swap-mid 600
until motion still
anim duration default
expect tile.find open
expect responder terminal-find
until tile.find.status 1 of 1 5000
capture n1a-after 0

log === N1b a herdr restart under an open find bar: the bar keeps the keyboard
sh @HD@ {session} server stop >/dev/null 2>&1
wait 1500
remember terminal.phase
sh nohup @HD@ {session} server >/dev/null 2>&1 &
wait 1000
until terminal.phase attached 10000
wait 2000
expect tile.find open
expect responder terminal-find
type x
expect tile.find.query azjneedlex
remember tile.find.status
key backspace
capture n1b-after-restart 300
wait 500

log === N1c cmd+k over an open find bar, then escape: the bar gets the keyboard back
key cmd+k
until palette all 2000
key escape
until palette closed 2000
expect tile.find open
expect responder terminal-find

log === N1d a tab switch with the bar open
key cmd+shift+t
until tabs 2 3000
until terminal.phase attached 10000
key ctrl+1
until tab 1 2000
until motion still
expect tile.find open
expect responder terminal-find
key cmd+shift+f
expect responder terminal-find
key escape
expect tile.find closed
expect responder terminal

log === N1h the find bar at the minimum window size
# herdr's restart (N1b) gave the pane a fresh shell: print the needle again.
type echo azj''needle
key enter
sh @HERE@/../focus/pane-has.sh {herdr} {session} {pane} azjneedle
key cmd+shift+f
expect tile.find.query azjneedle
until tile.find.status 1 of 1 5000
expect tile.find.controls count,steps,close
window-size 480 320
wait 1000
shot n1h-min-find
# V19: the controls drop out whole; the query keeps the keyboard.
expect tile.find.controls -
expect responder terminal-find
window-size 1440 900
wait 800
expect tile.find.controls count,steps,close
key escape
expect responder terminal

# ------------------------------------------- tab 2 (manual): files open
key ctrl+2
until tab 2 2000
core {"method":"layout.set","params":{"kind":"manual"}}
until motion still

log === N2 azj files open from a terminal: each file opens in the editor beside it
core {"method":"terminal.send_text","params":{"text":"cd @FX@; @AZJ@ files open --path plan.md > @OUT@/open1.out 2>&1; echo exit=$status >> @OUT@/open1.out; @AZJ@ files open --path main.rs > @OUT@/open2.out 2>&1; echo exit=$status >> @OUT@/open2.out; @AZJ@ files open --path nope.md > @OUT@/open3.out 2>&1; echo exit=$status >> @OUT@/open3.out\n"}}
until tiles 4 8000
wait 1500
remember tiles
shot n2-files-open

# ----------------------------------------------------- tab 3: HUD error wording
key cmd+shift+t
until tabs 3 3000
until terminal.phase attached 10000
log === N3 HUD messages for refused moves name no IDs
key alt+l
capture n3-hud-focus 120
captured
key ctrl+alt+shift+l
capture n3-hud-resize 120
captured
key alt+shift+l
capture n3-hud-swap 120
captured

# ------------------------------------------------------ tab 4 (Tile): badges
key cmd+shift+t
until tabs 4 3000
until terminal.phase attached 10000
key ctrl+cmd+t
key ctrl+cmd+t
key ctrl+cmd+t
until tiles 4 5000
until motion still
log === N5 no agent badge in headers by default: each agent tile shows its status icon
# A quiet agent (idle, nothing unread): the kind icon leads its title.
# Where the title starts, for once the agent works (its ring takes the same
# slot, so the title stays put).
key alt+h
expect focus 1
until motion still
expect tile.header.lead icon
sh {herdr} --session {session} pane report-agent {pane:1} --source e2e --agent claude --state idle
until tile.header.title claude 3000
wait 300
expect tile.header.lead icon
remember tile.header.titlex
sh {herdr} --session {session} pane report-agent {pane:1} --source e2e --agent claude --state working
sh {herdr} --session {session} pane report-agent {pane:2} --source e2e --agent codex --state blocked
sh {herdr} --session {session} pane report-agent {pane:3} --source e2e --agent claude --state working
wait 500
sh {herdr} --session {session} pane report-agent {pane:3} --source e2e --agent claude --state idle
until agents working,blocked!,done!,none 5000
remember agents
remember badges
expect tile.badge.setting off
until header.agents working,blocked,done,none 2000
wait 600
shot n5-badges
window-size 760 480
wait 1000
expect header.agents working,blocked,done,none
shot n5-badges-narrow
window-size 1440 900
wait 800
# The working tile's ring takes the kind icon's place before the title:
# nothing at the right end, and the title hasn't moved.
key alt+h
expect focus 1
expect tile.header.inset 0
expect tile.header.lead working
unchanged tile.header.titlex
# Blocked and focused: the icon stays, without text. Up the stack from its
# last tile. Focus alone answers nothing and reads nothing (tile 3 is passed
# on the way; reading is the shell's dwell, see agents.azs).
key alt+l
key alt+k
key alt+k
expect focus 2
wait 300
expect agents working,blocked!,done!,none
expect header.agents working,blocked,done,none
expect tile.header.lead blocked
expect tile.header.inset 0
key alt+h
expect focus 1
log === N5a tile_agent_badge = true brings the badge back, live
sh cp {config} {config}.n5
sh printf '\n[appearance]\ntile_agent_badge = true\n' >> {config}
until tile.badge.setting on 4000
until header.agents badge,badge,badge,none 2000
# The working tile's badge takes room from its title at the right end; the
# kind icon leads the title again.
remember tile.header.inset
expect tile.header.lead icon
wait 600
shot n5a-badges-on
sh cp {config}.n5 {config}
until tile.badge.setting off 4000
until header.agents working,blocked,done,none 2000
expect tile.header.inset 0
expect tile.header.lead working
unchanged tile.header.titlex
log === N5c mid-swap: the blocked icon rides its strip into the master area
key alt+l
expect focus 2
anim duration 1500
key alt+shift+h
capture n5-badge-swap-mid 650
until motion still
anim duration default
expect header.agents blocked,working,done,none

log === N6 the config banner row, with a blocked icon and the find bar open
key alt+h
expect focus 1
remember chrome.tiles
key cmd+shift+f
type azj
sh cp {config} {config}.orig
sh printf '\nthis is [not toml\n' >> {config}
until banner.shown yes 4000
wait 600
expect responder terminal-find
expect tile.find open
shot n6-banner-badge-find
key escape
expect responder terminal

# --------------------------------------------- tab overflow (banner still up)
log === N4 tab overflow: 14 tabs, attention on a hidden tab, the selected tab in view
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
key cmd+shift+t
until tabs 14 6000
until motion still
remember tab.overflow
remember tab.statuses
shot n4-overflow-last
key ctrl+4
until tab 4 2000
until motion still
remember tab.overflow
shot n4-overflow-tab4
window-size 480 320
wait 1000
remember tab.overflow
# N4c: the selected tab still shows (the ⌘ button leaves the strip room to
# scroll at the minimum size, so it shows among its neighbours, scrolled into
# view); V25: the banner is capped.
expect tab.overflow left,right
expect banner.capped yes
shot n4-overflow-min-banner
window-size 1440 900
wait 800
sh cp {config}.orig {config}
until banner.shown no 4000
wait 600
unchanged chrome.tiles
key ctrl+9
until tab 14 2000
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
key cmd+shift+w
until tabs 4 6000
until motion still
remember tab.overflow
shot n4-overflow-gone
