# B3: the maintainer's tall flow in a dynamic Tile tab, then the layout cycle with
# PTY resize accounting (anim expect-clean: one resize per changed terminal
# per motion, none for Monocle focus switches).
log B3 dynamic layouts
anim require-frames
delivery direct
until terminal.phase attached 10000
expect kind tile
# --- the tall flow, keystroke for keystroke ---
key ctrl+cmd+t
key ctrl+cmd+t
key ctrl+cmd+t
until tiles 4 3000
expect focus 4
expect masters 1
wait 1500
anim reset
key alt+enter
expect key.last action:promote_tile
expect focus 1
until motion still
key alt+o
expect orientation top
until motion still
key alt+o
expect orientation right
until motion still
key alt+o
expect orientation bottom
until motion still
key alt+o
expect orientation left
until motion still
key alt+l
key ctrl+alt+shift+j
until motion still
key alt+shift+e
expect key.last action:equalize_layout
until motion still
key alt+h
key ctrl+alt+shift+l
expect ratio 0.54
until motion still
shot 01-tall-flow
# --- cycle Tile → Three Column → Monocle, manual and back ---
key alt+backslash
expect kind three_column
until motion still
key alt+backslash
expect kind monocle
until motion still
remember resizes
key alt+l
until motion still
key alt+l
until motion still
key alt+h
wait 400
unchanged resizes
shot 02-monocle
key alt+shift+backslash
expect kind three_column
until motion still
shot 03-three-column
# --- Three Column on its side: alt+o swaps columns and rows, and back.
# The focused tile sits in the right stack, which goes to the bottom. ---
expect orientation columns
expect axis h
expect rect.focused 714,0,286x1000
key alt+o
expect key.last action:rotate_layout
expect orientation rows
expect axis v
until motion still
expect rect.focused 0,714,1000x286
shot 03b-three-column-rows
key alt+o
expect orientation columns
expect axis h
until motion still
expect rect.focused 714,0,286x1000
key alt+shift+t
expect kind manual
until motion still
key alt+shift+t
expect kind three_column
until motion still
key alt+t
expect kind tile
until motion still
anim stats dyn-stats
# Frames the app drops (its main thread busy through the gap): a layout
# switch's first frame lays out and redraws the tab's chrome (~9 ms on
# 120 Hz's 8.3 ms), so one now and then; a 30 ms stall in each motion drops
# ~19. Frames the system misses (main thread idle) don't count here.
anim expect-clean 2
shot 04-back-to-tile
# What herdr itself holds on each pane's screen, next to the in-app shot.
wait 1500
shot 05-settled
sh for i in 1 2 3 4; do :; done; {herdr} --session {session} pane read {pane:1} --source visible --format text > {out}/pane1.txt; {herdr} --session {session} pane read {pane:2} --source visible --format text > {out}/pane2.txt; {herdr} --session {session} pane read {pane:4} --source visible --format text > {out}/pane4.txt
