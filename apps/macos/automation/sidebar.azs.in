# Sidebar check, in-process. sidebar.sh fills in @DIR@: a folder of
# small git repos named after the workspaces, each on its own branch.
# Agent states are simulated with `herdr pane report-agent` on the dev
# instance's own herdr session (herdr can't report "done").

log sidebar
seen-visible off
sidebar mode workspaces
expect sidebar.mode workspaces
until sidebar.machines Local ● 5000

# Five workspaces like the mockup's: azulejo (working), sample-service (blocked),
# sample-project (long branch, blocked), sample-dashboard (idle), config.
core {"method":"workspace.rename","params":{"name":"azulejo"}}
core {"method":"workspace.set_repo","params":{"path":"@DIR@/azulejo"}}
action new_workspace
until workspaces 2 5000
core {"method":"workspace.rename","params":{"name":"sample-service"}}
core {"method":"workspace.set_repo","params":{"path":"@DIR@/sample-service"}}
action new_workspace
until workspaces 3 5000
core {"method":"workspace.rename","params":{"name":"sample-project"}}
core {"method":"workspace.set_repo","params":{"path":"@DIR@/sample-project"}}
action new_workspace
until workspaces 4 5000
core {"method":"workspace.rename","params":{"name":"sample-dashboard"}}
core {"method":"workspace.set_repo","params":{"path":"@DIR@/sample-dashboard"}}
action new_workspace
until workspaces 5 5000
core {"method":"workspace.rename","params":{"name":"config"}}
core {"method":"workspace.set_repo","params":{"path":"@DIR@/config"}}
until sidebar.branches main|development|audit/critical-path-review|dev|main 5000
expect sidebar.statuses idle|idle|idle|idle|idle
expect sidebar.footer working=0,blocked=0,idle=5,done=0

# Agent states: each workspace's terminal needs its herdr binding first.
action switch_workspace 1
wait 1500
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent claude --state working
wait 400
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent claude --state working
until sidebar.statuses working|idle|idle|idle|idle 5000
action switch_workspace 2
wait 1000
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent claude --state blocked
wait 400
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent claude --state blocked
action switch_workspace 3
wait 1000
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent codex --state blocked
wait 400
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent codex --state blocked
until sidebar.statuses working|blocked|blocked|idle|idle 5000
expect sidebar.footer working=1,blocked=2,idle=2,done=0
expect sidebar.markers ●|●1|●1|-|-
# The footer in words, zero counts left out; two-line rows with the time
# in state on the waiting and working ones (a minute hasn't passed).
expect sidebar.footer.words 2 waiting · 1 working · 2 idle
expect sidebar.heights 40|40|40|40|40
expect sidebar.rows azulejo now ¦ main ‖ sample-service now ¦ development ‖ sample-project now ¦ audit/cr…al-path-review ‖ sample-dashboard ¦ dev ‖ config ¦ main
expect sidebar.machines Local ●
expect sidebar.empty -
action switch_workspace 1
expect workspace 1
shot 01-workspaces

# A row shows no hover card, only its hover fill (the rail's rows have
# cards); a row whose branch is cut short has a plain tooltip with it in
# full, the others none.
sidebar hover 3
wait 900
expect sidebar.card -
expect sidebar.tips - ‖ - ‖ sample-project ¦ audit/critical-path-review ‖ - ‖ -
shot 01-hover
sidebar hover 0
expect sidebar.card -

# A short window: only the list scrolls, its bottom edge fades, a pill
# counts the rows below and the waiting ones among them; a click on it
# brings the nearest waiting row into view. Scrolled to the end, the top
# edge fades and a pill counts the waiting rows above; its click brings
# the nearest one back.
window-size 900 250
wait 400
expect sidebar.active.visible yes
until sidebar.fades bottom 1500
expect sidebar.overflow 0/0 3/1
expect sidebar.pills -|↓ 3 more · 1 waiting
shot 01-overflow
sidebar pill bottom
wait 200
expect sidebar.overflow 1/0 1/0
expect sidebar.pills -|↓ 1 more
expect sidebar.fades both
sidebar scroll bottom
wait 200
expect sidebar.overflow 2/1 0/0
expect sidebar.pills ↑ 1 waiting above|-
expect sidebar.fades top
shot 01-overflow-end
sidebar pill top
wait 200
expect sidebar.overflow 0/0 2/0
window-size 1100 700
wait 400
until sidebar.fades none 1500
expect sidebar.pills -|-

# A click on a row focuses its workspace.
sidebar select 4
expect workspace 4
sidebar select 1
expect workspace 1

# Files: the focused workspace's repository.
sidebar mode files
expect sidebar.mode files
until sidebar.files.names src,README.md 5000
expect sidebar.files.root @DIR@/azulejo
shot 02-files
sidebar focus
expect sidebar.files.keyboard yes
key j
expect sidebar.files.selected README.md
key k
expect sidebar.files.selected src
key l
until sidebar.files.names src,main.rs,README.md 3000
# A refresh from the core (agent state, headers) leaves the keyboard here.
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent claude --state working
wait 600
expect sidebar.files.keyboard yes
# Return opens the file in the editor: a new terminal beside the focused
# tile runs `[editor] command` on it and takes focus, keyboard included.
remember tiles
key j
expect sidebar.files.selected src/main.rs
key return
until tiles 2 3000
until focus 2 3000
until sidebar.files.editor command:vim @DIR@/azulejo/src/main.rs 3000
until sidebar.files.keyboard no 3000
shot 03-opened
# The tree takes the keyboard back; Esc hands it to the focused tile.
sidebar focus
expect sidebar.files.keyboard yes
expect sidebar.files.selected src/main.rs
key esc
expect sidebar.files.keyboard no
expect focus 2

# Another workspace: the tree follows its repository.
action switch_workspace 2
until sidebar.files.root @DIR@/sample-service 3000
expect sidebar.files.names README.md

# Back to the list; the panel closes.
sidebar mode workspaces
expect sidebar.mode workspaces
expect sidebar.statuses working|blocked|blocked|idle|idle
shot 04-back

# ---- The rail: the collapsed sidebar (toggle_sidebar, default [sidebar]
# collapsed = "rail"). Same data as the full sidebar.

# Another agent in a second tab of sample-dashboard, in its second tile: the
# rail shows it on its workspace's row only (no agent list of its own).
action switch_workspace 4
action new_tab
until tabs 2 5000
key ctrl+cmd+t
until tiles 2 5000
wait 1500
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent codex --state working
wait 400
sh {herdr} --session {session} pane report-agent {pane} --source azj-test --agent codex --state working
until sidebar.statuses working|blocked|blocked|working|idle 5000
action switch_workspace 1
expect workspace 1

# Files had the keyboard: collapsing hands it back to the focused tile.
sidebar mode files
sidebar focus
expect sidebar.files.keyboard yes
action toggle_sidebar
until sidebar rail 3000
expect responder.focused yes
expect rail.keyboard no
sidebar mode workspaces
wait 600
expect rail.shown yes
expect rail.groups L:connected
expect rail.rows 1:working*|2:blocked|3:blocked|4:working|5:idle
# Rows sit as far from the left edge as from the right, their number and
# icon centred between.
expect rail.fits yes
expect rail.centred yes
expect rail.insets 4/4|4/4|4/4|4/4|4/4
# Status icons only: no numbers at rest (⌘ held shows them, wshints.sh).
expect rail.heights 28|28|28|28|28
expect rail.hints hidden
expect rail.hints.placed yes
expect rail.offsets 0|0|0|0|0|0
expect chrome.rail.overlaps none
expect chrome.hit.close _NSThemeCloseWidget
expect chrome.hit.toggle SidebarToggleButton
until rail.spinning 2 3000
expect rail.tips azulejo (⌘1) ¦ main ¦ 1 working ‖ sample-service (⌘2) ¦ development ¦ 1 blocked ‖ sample-project (⌘3) ¦ audit/critical-path-review ¦ 1 blocked ‖ sample-dashboard (⌘4) ¦ dev ¦ 1 working ‖ config (⌘5) ¦ main ¦ no agents
expect rail.group.tips Local ¦ Connected
shot 05-rail
capture 05-rail-window 0

# Clicks: a workspace row focuses it, through the row's own mouse handling
# too (a press that doesn't move is a click, not a drag).
sidebar rail select 3
expect workspace 3
until rail.rows 1:working|2:blocked|3:blocked*|4:working|5:idle 2000
sidebar drag click 2
expect workspace 2
# Right-click on a rail row: the workspace's own menu.
menu rail 1
remember menu.items
menu workspace 1
unchanged menu.items

# The rail's footer counts the waiting workspaces; a letter's card says
# the machine's state.
expect rail.wait 2
sidebar rail group 1
until sidebar.card Local ¦ Connected ¦ 5 workspaces · azulejo, sample-service, sample-project, sample-dashboard, config 1000
# Its list wraps between words; the name and state keep to a line each.
expect sidebar.card.lines 1|1|2
expect sidebar.card.overflow none
sidebar rail hover 0

# A row's card keeps each value to one line, as wide as its longest line
# (space.hoverCardMinWidth to hoverCardMaxWidth), cut only past that. A
# deep folder on a long branch with uncommitted changes (sidebar.sh's
# @CARD@ fixtures): the branch whole, the sidebar's dot after it and the
# words on a line of their own; the path cut in its middle, its last
# folder whole. config is idle, so its state has no time to tick over.
action switch_workspace 5
until workspace.active config 2000
core {"method":"workspace.set_repo","params":{"path":"@CARD@/clients/example-studio/quarterly-reporting-dashboard"}}
until sidebar.branches main|development|audit/critical-path-review|dev|chore/release-candidate-handover-final • 5000
until rail.dirty -|-|-|-|• 5000
sidebar rail hover 5
expect sidebar.card config ⌘5 ¦ chore/release-candidate-handover-final • ¦ Uncommitted changes ¦ Idle ¦ @CARD@/clients/example-studio/quarterly-reporting-dashboard
expect sidebar.card.drawn config ⌘5 ¦ chore/release-candidate-handover-final • ¦ Uncommitted changes ¦ Idle ¦ /private/tmp/…/quarterly-reporting-dashboard
expect sidebar.card.lines 1|1|1|1|1
expect sidebar.card.overflow none
expect sidebar.card.width 380
shot 05-rail-card
sidebar rail hover 0
# A branch too long for the widest card: cut in its middle, its feature/
# prefix kept.
core {"method":"workspace.set_repo","params":{"path":"@CARD@/clients/example-studio/upload-service"}}
until sidebar.branches main|development|audit/critical-path-review|dev|feature/upload-retry-with-exponential-backoff-and-jitter-for-large-files 5000
until rail.dirty -|-|-|-|- 5000
sidebar rail hover 5
expect sidebar.card config ⌘5 ¦ feature/upload-retry-with-exponential-backoff-and-jitter-for-large-files ¦ Idle ¦ @CARD@/clients/example-studio/upload-service
expect sidebar.card.drawn config ⌘5 ¦ feature/upload-ret…ff-and-jitter-for-large-files ¦ Idle ¦ /private/…/clients/example-studio/upload-service
expect sidebar.card.lines 1|1|1|1
expect sidebar.card.overflow none
expect sidebar.card.width 380
sidebar rail hover 0
# A short card is no narrower than hoverCardMinWidth.
sidebar rail wait
expect sidebar.card.lines 1
expect sidebar.card.width 200
sidebar rail hover 0
core {"method":"workspace.set_repo","params":{"path":"@DIR@/config"}}
until sidebar.branches main|development|audit/critical-path-review|dev|main 5000
action switch_workspace 2
until workspace.active sample-service 2000

# A short window: the rail scrolls between its top and its footer. Folding
# brings the active row into view (only a few of its 28 pt rows fit, so the
# window is shorter than the full sidebar's check); a marker
# flags the waiting rows out of view, and a click on it scrolls to the
# nearest.
action toggle_sidebar
until sidebar visible 3000
window-size 900 220
action switch_workspace 5
until workspace.active config 2000
action toggle_sidebar
until sidebar rail 3000
wait 400
expect rail.active.visible yes
expect rail.markers ↑1|-
shot 05-rail-overflow
sidebar rail marker top
wait 200
expect rail.active.visible no
expect rail.markers -|-
sidebar rail scroll top
wait 200
expect rail.markers -|↓1
window-size 1100 700
wait 400
expect rail.fits yes
action switch_workspace 2
until workspace.active sample-service 2000

# Off: the full sidebar again, rows back; » does the same from the rail.
action toggle_sidebar
until sidebar visible 3000
until rail.shown no 2000
action toggle_sidebar
until sidebar rail 3000
sidebar rail expand
until sidebar visible 3000
# Collapsed for the relaunch check (sidebar-relaunch.azs).
action toggle_sidebar
until sidebar rail 3000
wait 800
