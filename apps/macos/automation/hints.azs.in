expect hints.callouts 2
expect hints.legend extend to B…,back,cancel
expect hints.callout.typed b:2
shot hints-extend-typed
key backspace
expect hints.extend -
key shift+b
key shift+s
expect hints.extend -
expect hints.selected https://example.invalid/first↵界👩‍💻é ./src/example.swift:12:3↵* feature/hints↵  feature/other
shot hints-range
key c
expect hints.state closed
clip has https://example.invalid/first
clip has feature/other

