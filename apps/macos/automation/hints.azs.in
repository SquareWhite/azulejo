log === Light theme: the key panel, labels, paragraphs and a range
theme set atom-one-light
wait 600
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat tool-call.txt"
wait 400
key cmd+s
expect hints.callout.covers 0
expect hints.callout.slant 0
expect hints.panel.position bottom
shot hints-light-categories
key c
shot hints-light-commands
key escape
sh {herdr} --session {session} pane run {pane} "sh sheet.sh"
wait 600
key cmd+s
expect hints.callout.clash 0
expect hints.callout.hides 0
expect hints.callout.slant 0
key u
shot hints-light-urls
key backspace
key l
expect hints.callout.clash 0
expect hints.callout.flagged 0
expect hints.lines.all yes
shot hints-light-lines
key up
expect hints.focus.kind line
expect hints.panel pick,move,select,categories,close
shot hints-light-focus
key enter
expect hints.kind line
key shift+up
key shift+up
expect hints.kind range
expect hints.panel copy,move,hold to extend,grow/shrink,back,close
shot hints-light-range
key escape
key cmd+s
hints select 192.0.2.47
key alt+up
key alt+up
expect hints.kind text
shot hints-light-paragraph
key escape
theme set atom-one-dark
wait 600
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt"
wait 400

log === A cwd update cancels and restores terminal focus
key cmd+s
sh mkdir -p @DIR@/nested/src; touch @DIR@/nested/src/example.swift; {herdr} --session {session} pane run {pane} "cd nested"
until hints.state closed 10000
until terminal.cwd @DIR@/nested 10000
expect responder terminal
key cmd+s
hints select ./src/example.swift:12:3
key o
hints opened-file @DIR@/nested/src/example.swift

log === Run creates a real pane and executes in the source directory
key cmd+s
hints select printf hint-ran > ran.txt
expect hints.kind command
expect hints.actions copy,run
shot hints-command-popup
key r
expect hints.state closed
until tiles 2
until terminal.phase attached 10000
wait 500
sh test "$(cat @DIR@/nested/ran.txt)" = hint-ran
action close_tile
until tiles 1
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "cd .."
until terminal.cwd @DIR@ 10000

log === Run on a multi-line tool call goes through /bin/sh, whatever the login shell
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat shell-probe.txt"
wait 400
key cmd+s
key c
key a
key r
until tiles 2
until terminal.phase attached 10000
wait 1200
sh test @FISH@ = - || test -s @DIR@/shell.txt
action close_tile
until tiles 1
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat tool-heredoc.txt"
wait 400
key cmd+s
key c
key a
expect hints.kind command
expect hints.selected cat > heredoc-ran.txt <<'EOF'↵heredoc-ran↵EOF
expect hints.actions copy,run
key r
expect hints.state closed
until tiles 2
until terminal.phase attached 10000
wait 1200
sh test "$(cat @DIR@/heredoc-ran.txt)" = heredoc-ran
action close_tile
until tiles 1
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt"
wait 400

log === Run reuses idle shells ([hints] run_target = "reuse", the default)
sh printf '[herdr]\nsession = "{session}"\n[keys.macos.terminal]\nselect_visible_item = "cmd+s"\n' > {config}
action reload_config
wait 400
sh rm -f @DIR@/ran.txt @DIR@/junk.txt @DIR@/shell.txt @DIR@/heredoc-ran.txt
until hints.run.idle idle 10000

log === Run in an idle shell types the command into the current pane
key cmd+s
hints select printf hint-ran > ran.txt
expect hints.actions copy,run
key r
expect hints.state closed
expect hints.run.target current
expect tiles 1
expect focus 1
wait 800
sh test "$(cat @DIR@/ran.txt)" = hint-ran
expect responder terminal

log === From a busy pane, Run goes to the idle split beside it, in the source's directory
sh rm -f @DIR@/ran.txt
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@/nested"}}}
until tiles 2
until terminal.phase attached 10000
action focus_tile_left
until focus 1
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt; sleep 120"
until hints.run.idle busy,idle 15000
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.state closed
expect hints.run.target reuse:2
expect tiles 2
expect focus 2
until terminal.cwd @DIR@ 10000
wait 500
sh test "$(cat @DIR@/ran.txt)" = hint-ran
expect responder terminal
expect responder.focused yes
shot hints-run-reuse

log === The reused login shell (fish when installed) runs a multi-line command through /bin/sh
action focus_tile_left
until focus 1
sh {herdr} --session {session} pane send-keys {pane} ctrl+c
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat shell-probe.txt; sleep 120"
until hints.run.idle busy,idle 15000
sh {herdr} --session {session} pane run {pane:2} "clear"
wait 400
key cmd+s
key c
key a
expect hints.kind command
key r
expect hints.run.target reuse:2
expect tiles 2
wait 1200
sh test @FISH@ = - || test -s @DIR@/shell.txt
action focus_tile_left
until focus 1
sh {herdr} --session {session} pane send-keys {pane} ctrl+c
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat tool-heredoc.txt; sleep 120"
until hints.run.idle busy,idle 15000
sh {herdr} --session {session} pane run {pane:2} "clear"
wait 400
key cmd+s
key c
key a
expect hints.selected cat > heredoc-ran.txt <<'EOF'↵heredoc-ran↵EOF
key r
expect hints.run.target reuse:2
expect tiles 2
wait 1200
sh test "$(cat @DIR@/heredoc-ran.txt)" = heredoc-ran

log === Half-typed input in the reused shell is cleared first: login shell (fish when installed)
action focus_tile_left
until focus 1
sh {herdr} --session {session} pane send-keys {pane} ctrl+c
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt; sleep 120"
until hints.run.idle busy,idle 15000
sh rm -f @DIR@/ran.txt @DIR@/junk.txt
sh {herdr} --session {session} pane send-text {pane:2} "touch junk.txt; "
wait 300
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.run.target reuse:2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran && test ! -e @DIR@/junk.txt

