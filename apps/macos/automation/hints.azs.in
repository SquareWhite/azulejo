# Background-only terminal hint scenarios; hints.sh supplies fixture paths.
delivery direct
clip clear
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 2
until terminal.phase attached 10000
action focus_tile_left
action close_tile
until tiles 1
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "stty -echo; PS1=; printf '\033[2J\033[H'; cat screen.txt"
wait 600

log === ⌘S shows the key panel and no labels; a category key shows its own, labelled a, s, d…
anim enabled true
anim reduce-motion false
key cmd+s
expect key.last action:select_visible_item
expect hints.state choosing
expect hints.category -
expect hints.popup hidden
expect hints.panes 1
expect hints.count 6
expect hints.types url,path,branch,branch,command,path
expect hints.labels a,a,a,s,a,s
expect hints.keys ua,pa,ba,bs,ca,ps
expect hints.lines 6
expect hints.visible 0
expect hints.callouts 0
expect hints.panel.title Select
expect hints.panel URL,paths,command,lines,hashes & IDs,IP addresses,domains,branches,close
expect hints.panel.keys u,p,c,l,h,i,d,b,esc
expect hints.panel.dimmed h,i,d
expect hints.panel.position bottom
expect hints.panel.fits yes
expect hints.callout.typed -
shot hints-categories
log --- a key with nothing on screen does nothing; a category of one selects its item at once
key h
expect hints.category -
expect hints.visible 0
key u
expect hints.state selected
expect hints.category url
expect hints.kind url
expect hints.label a
expect hints.selected https://example.invalid/first
expect hints.actions copy,open
expect hints.panel.title Selected URL
expect hints.visible 0
expect hints.callouts 0
shot hints-urls
log --- backspace from it goes back to the categories
key backspace
expect hints.state choosing
expect hints.category -
expect hints.visible 0
log --- a category of several shows its labels
key p
expect hints.category path
expect hints.shown.kinds path
expect hints.shown.labels a,s
expect hints.panel.title 2 paths
hints callout below ./src/example.swift:12:3
expect hints.panel.fits yes
shot hints-paths
key s
expect hints.state selected
expect hints.selected two words.txt
key backspace
expect hints.state choosing
expect hints.category path
expect hints.prefix -
expect hints.visible 2
key backspace
key b
expect hints.shown.kinds branch
expect hints.shown.labels a,s
hints callout above feature/hints
key x
expect hints.prefix -
key backspace
expect hints.category -
expect hints.fade 80
anim enabled false
key b
key backspace
expect hints.fade 0
anim enabled default
anim reduce-motion default
key u
expect hints.state selected
expect hints.kind url
expect hints.label a
expect hints.selected https://example.invalid/first
expect hints.actions copy,open
expect hints.panel.title Selected URL
expect hints.panel copy,open,move,hold to extend,grow,back,close
expect hints.panel.fits yes
expect hints.popup visible
expect hints.popup.fits yes
expect hints.callouts 0
expect hints.visible 0
shot hints-selected
key c
expect hints.state closed
expect hints.panel.position hidden
expect clipboard https://example.invalid/first
expect responder terminal

log === Agent footers, editor mode lines and bare prompts hold no items; boxes sit on their text
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat footer.txt"
wait 500
key cmd+s
expect hints.rows path:5,path:5,path:7,path:7
expect hints.unlabelled 2
expect hints.panel.dimmed u,c,h,i,d,b
expect hints.boxes.rows yes
key p
expect hints.shown.labels a,s
shot hints-footer-paths
key escape
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt"
wait 400

log === Selected: the category's other labels hide; holding shift shows them, shift + label extends
key cmd+s
key b
key a
expect hints.selected feature/hints
expect hints.callouts 0
expect hints.reach hidden
expect hints.visible 1
mouse mods shift
until hints.reach shown 2000
expect hints.callouts 1
expect hints.shown.labels s
shot hints-selected-shift
mouse mods none
expect hints.reach hidden
expect hints.callouts 0
key shift+s
expect hints.extend -
expect hints.kind range
expect hints.selected feature/hints↵  feature/other
expect hints.panel.title Selected range
shot hints-range
key c
expect hints.state closed
clip has feature/hints
clip has feature/other

