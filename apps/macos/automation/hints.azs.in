# Background-only terminal hint scenarios; hints.sh supplies fixture paths.
delivery direct
clip clear
until terminal.phase attached 10000
core {"method":"layout.set","params":{"kind":"manual"}}
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 2
until terminal.phase attached 10000
action focus_tile_left
action close_tile
until tiles 1
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "stty -echo; PS1=; printf '\033[2J\033[H'; cat screen.txt"
wait 600

log === Labels start with their kind's letter, filter as you type, then select and copy
anim enabled true
anim reduce-motion false
key cmd+s
expect key.last action:select_visible_item
expect hints.state choosing
expect hints.popup hidden
expect hints.panes 1
expect hints.count 6
expect hints.labels u,pa,ba,bs,c,ps
expect hints.lines 6
expect hints.visible 6
expect hints.callout.clash 0
expect hints.callout.hides 0
expect hints.callout.flagged 0
expect hints.callout.slant 0
expect hints.callout.covers 0
hints callout below https://example.invalid/first
hints callout left ./src/example.swift:12:3
hints callout inline feature/hints
expect hints.legend url,path,command,line,branch,move,cancel
expect hints.legend.keys u,p,c,l,b,↑↓←→,esc
expect hints.legend.position header
expect hints.legend.tile focused
expect hints.legend.fits yes
expect hints.callout.typed -
shot hints-choosing
key p
expect hints.prefix p
expect hints.visible 2
expect hints.fade 80
expect hints.legend path,move,back,cancel
expect hints.callout.typed p:2
expect hints.legend.moves 0
shot hints-filtered
key x
expect hints.prefix p
key backspace
expect hints.prefix -
expect hints.visible 6
anim enabled false
key b
expect hints.fade 0
key backspace
anim enabled default
anim reduce-motion default
key u
expect hints.state selected
expect hints.kind url
expect hints.label u
expect hints.selected https://example.invalid/first
expect hints.actions copy,open
expect hints.legend copy,open,move,hold to extend,grow,cancel
expect hints.popup visible
expect hints.popup.fits yes
log --- the other labels hide once an item is selected; holding shift shows them
expect hints.callouts 0
expect hints.reach hidden
expect hints.visible 5
shot hints-selected
mouse mods shift
until hints.reach shown 2000
expect hints.callouts 5
shot hints-selected-shift
mouse mods none
expect hints.reach hidden
expect hints.callouts 0
key c
expect hints.state closed
expect clipboard https://example.invalid/first
expect responder terminal

