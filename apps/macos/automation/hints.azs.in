key cmd+s
key u
key down
expect hints.kind path
expect hints.selected ./src/example.swift:12:3
key right
expect hints.selected feature/hints
key left
key up
expect hints.kind url
key shift+down
expect hints.kind range
expect hints.selected https://example.invalid/first↵界👩‍💻é ./src/example.swift:12:3
expect hints.actions copy
expect hints.legend copy,move,hold to extend,grow/shrink,cancel
key shift+b
expect hints.extend b
