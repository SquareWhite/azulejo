log === In Monocle, the reused shell comes to the front
action focus_tile_left
until focus 1
action toggle_layout_monocle
wait 600
expect kind monocle
sh rm -f @DIR@/ran.txt
key cmd+s
expect hints.panes 1
hints select printf hint-ran > ran.txt
key r
expect hints.run.target reuse:2
expect focus 2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran
action toggle_layout_manual
wait 400

log === With no idle shell, Run makes a new pane
sh {herdr} --session {session} pane run {pane:2} "sleep 120"
action focus_tile_left
until focus 1
until hints.run.idle busy,busy 15000
sh rm -f @DIR@/ran.txt
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.run.target new
until tiles 3
until terminal.phase attached 10000
expect focus 2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran
action close_tile
until tiles 2
sh {herdr} --session {session} pane send-keys {pane:2} ctrl+c
sh {herdr} --session {session} pane send-keys {pane:1} ctrl+c
action focus_tile_right
until focus 2
action close_tile
until tiles 1
until terminal.phase attached 10000
until hints.run.idle idle 10000
sh printf '[herdr]\nsession = "{session}"\n[keys.macos.terminal]\nselect_visible_item = "cmd+s"\n[hints]\nrun_target = "new"\n' > {config}
action reload_config
wait 400
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt"
wait 400

log === All visible panes participate, hidden panes do not
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 2
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "stty -echo; PS1=; printf '\033[2J\033[Hhttps://example.invalid/second\n'"
wait 500
