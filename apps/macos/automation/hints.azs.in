expect hints.selected feature/hints
key left
key up
expect hints.kind url
key shift+down
expect hints.kind range
expect hints.selected https://example.invalid/first↵界👩‍💻é ./src/example.swift:12:3
expect hints.actions copy
expect hints.panel copy,move,hold to extend,grow/shrink,back,close
key c
expect hints.state closed
clip has https://example.invalid/first
clip has ./src/example.swift:12:3

