until hints.run.idle busy,idle 15000
sh {herdr} --session {session} pane run {pane:2} "clear"
wait 400
key cmd+s
key c
expect hints.kind command
key r
expect hints.run.target reuse:2
expect tiles 2
wait 1200
sh test @FISH@ = - || test -s @DIR@/shell.txt
action focus_tile_left
until focus 1
sh {herdr} --session {session} pane send-keys {pane} ctrl+c
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat tool-heredoc.txt; sleep 120"
until hints.run.idle busy,idle 15000
sh {herdr} --session {session} pane run {pane:2} "clear"
wait 400
key cmd+s
key c
expect hints.selected cat > heredoc-ran.txt <<'EOF'↵heredoc-ran↵EOF
key r
expect hints.run.target reuse:2
expect tiles 2
wait 1200
sh test "$(cat @DIR@/heredoc-ran.txt)" = heredoc-ran

log === Half-typed input in the reused shell is cleared first: login shell (fish when installed)
action focus_tile_left
until focus 1
sh {herdr} --session {session} pane send-keys {pane} ctrl+c
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt; sleep 120"
until hints.run.idle busy,idle 15000
sh rm -f @DIR@/ran.txt @DIR@/junk.txt
sh {herdr} --session {session} pane send-text {pane:2} "touch junk.txt; "
wait 300
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.run.target reuse:2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran && test ! -e @DIR@/junk.txt

log === Half-typed input is cleared in zsh
action close_tile
until tiles 1
until focus 1
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -u EDITOR -u VISUAL HOME='@DIR@' /bin/zsh -f"]}}}
until tiles 2
until terminal.phase attached 10000
action focus_tile_left
until hints.run.idle busy,idle 15000
sh rm -f @DIR@/ran.txt @DIR@/junk.txt
sh {herdr} --session {session} pane send-text {pane:2} "touch junk.txt; "
wait 300
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.run.target reuse:2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran && test ! -e @DIR@/junk.txt

log === Half-typed input is cleared in bash
action close_tile
until tiles 1
until focus 1
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -u EDITOR -u VISUAL HOME='@DIR@' HISTFILE= /bin/bash --norc --noprofile"]}}}
until tiles 2
until terminal.phase attached 10000
action focus_tile_left
until hints.run.idle busy,idle 15000
sh rm -f @DIR@/ran.txt @DIR@/junk.txt
sh {herdr} --session {session} pane send-text {pane:2} "touch junk.txt; "
wait 300
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.run.target reuse:2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran && test ! -e @DIR@/junk.txt

log === In Monocle, the reused shell comes to the front
action focus_tile_left
until focus 1
action toggle_layout_monocle
wait 600
expect kind monocle
sh rm -f @DIR@/ran.txt
key cmd+s
expect hints.panes 1
hints select printf hint-ran > ran.txt
key r
expect hints.run.target reuse:2
expect focus 2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran
action toggle_layout_manual
wait 400

log === With no idle shell, Run makes a new pane
sh {herdr} --session {session} pane run {pane:2} "sleep 120"
action focus_tile_left
until focus 1
until hints.run.idle busy,busy 15000
sh rm -f @DIR@/ran.txt
key cmd+s
hints select printf hint-ran > ran.txt
key r
expect hints.run.target new
until tiles 3
until terminal.phase attached 10000
expect focus 2
wait 1000
sh test "$(cat @DIR@/ran.txt)" = hint-ran
action close_tile
until tiles 2
sh {herdr} --session {session} pane send-keys {pane:2} ctrl+c
sh {herdr} --session {session} pane send-keys {pane:1} ctrl+c
action focus_tile_right
until focus 2
action close_tile
until tiles 1
until terminal.phase attached 10000
until hints.run.idle idle 10000
sh printf '[herdr]\nsession = "{session}"\n[keys.macos.terminal]\nselect_visible_item = "cmd+s"\n[hints]\nrun_target = "new"\n' > {config}
action reload_config
wait 400
sh {herdr} --session {session} pane run {pane} "printf '\033[2J\033[H'; cat screen.txt"
wait 400

log === All visible panes participate, hidden panes do not
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 2
until terminal.phase attached 10000
sh {herdr} --session {session} pane run {pane} "stty -echo; PS1=; printf '\033[2J\033[Hhttps://example.invalid/second\n'"
wait 500
key cmd+s
expect hints.panes 2
expect hints.legend.position header
expect hints.legend.tile focused
hints select https://example.invalid/first
expect hints.legend.position header
expect hints.legend.tile focused
expect hints.legend.moves 0
shot hints-other-pane-legend
key escape
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 3
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 4
until terminal.phase attached 10000
wait 600
key cmd+s
expect hints.legend.position header
expect hints.legend.fits yes
expect hints.legend.keys esc
shot hints-narrow-legend
key escape
action close_tile
until tiles 3
action close_tile
until tiles 2
wait 400
action zoom_tile
wait 400
key cmd+s
expect hints.panes 1
hints select https://example.invalid/second
expect hints.popup.fits yes
shot hints-right-pane-popup
key escape
action zoom_tile
log === Monocle with three tiles: the legend stands in for the tabs, Esc brings them back
core {"method":"layout.split","params":{"direction":"right","content":{"kind":"terminal","cwd":"@DIR@","command":["exec env -i HOME='@DIR@' PATH=/usr/bin:/bin /bin/sh"]}}}
until tiles 3
until terminal.phase attached 10000
action toggle_layout_monocle
wait 600
expect tile.header.content tabs
expect tile.tabs 3
key cmd+s
expect hints.panes 1
expect tile.header.content override
expect hints.legend.position header
expect hints.legend.tile focused
expect hints.legend.fits yes
shot hints-monocle-legend
key escape
expect hints.state closed
expect tile.header.content tabs
expect tile.tabs 3
wait 300
shot hints-monocle-after
action toggle_layout_manual
wait 400
action close_tile
until tiles 2
wait 400

log === Resize and tab changes cancel the session
key cmd+s
window-size 1050 680
expect hints.state closed
key cmd+s
core {"method":"tab.create"}
expect hints.state closed
until terminal.phase attached 10000

log === Live rebinding stays terminal-only
sh printf '[herdr]\nsession = "{session}"\n[keys.macos.terminal]\nselect_visible_item = "cmd+shift+s"\n' > {config}
action reload_config
wait 400
key cmd+s
expect hints.state closed
expect key.last passed
key cmd+shift+s
expect hints.state choosing
key escape
# In the find bar the tile's context is off, so the terminal binding is too.
key cmd+shift+f
expect key.last action:find
key cmd+shift+s
expect hints.state closed
expect key.last passed
key escape
quit
