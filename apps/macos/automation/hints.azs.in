key alt+down
expect hints.kind line
key down
expect hints.kind line
expect hints.selected feature/other
key alt+down
expect hints.kind branch
expect hints.selected feature/other
key backspace
expect hints.state choosing
expect hints.prefix b
expect hints.visible 2
key escape
expect hints.state closed

