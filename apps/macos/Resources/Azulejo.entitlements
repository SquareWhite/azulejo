<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the release build (docs/release.md).
  Deliberately empty:
  - libghostty compiles Metal shaders through the system Metal compiler
    service (runtime-Metal patch), which needs no entitlement either.
  - Everything is statically linked: no disable-library-validation.
  - The app is not sandboxed: it spawns herdr, lists arbitrary folders in
    its Files view and serves a Unix socket in $TMPDIR.
-->
<plist version="1.0">
<dict/>
</plist>
